"}, "elements": [{"id": "81645b2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "09d64ef", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "3c93025", "elType": "widget", "widgetType": "heading", "settings": {"title": "Ceník · Ostrava", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "d2fd917", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Tvorba webových stránek Ostrava</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "1915694", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná částka se odvíjí od rozsahu, funkcí a grafického zpracování. Každý projekt naceňujeme individuálně a férově.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "3ebbe57", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "02e27a5", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "a433ab2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "b4f9b93", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – tvorba webových stránek Ostrava", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "b6c7ffe", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "edc94b0", "tab_title": "Kolik stojí tvorba webových stránek v Ostravě?", "tab_content": "<p>Tvorba webových stránek Ostrava začíná na 9 900 Kč. Konečná cena záleží na rozsahu, funkcích a grafickém zpracování. Po krátké konzultaci dostanete nezávaznou nabídku zdarma.</p>"}, {"_id": "0a1b2c0", "tab_title": "Musím za vámi jezdit do Jeseníku?", "tab_content": "<p>Nemusíte. Konzultace, návrhy i předání webu zvládneme online – telefonem, videohovorem a e-mailem. Když je to potřeba, rádi se potkáme i osobně.</p>"}, {"_id": "07a4956", "tab_title": "Pomůžete, aby nás našli zákazníci z Ostravy?", "tab_content": "<p>Ano. Web postavíme s ohledem na lokální SEO pro Ostrava – obsah zaměřený na vaše služby a lokalitu, Google Firemní profil a technické SEO od prvního dne.</p>"}, {"_id": "e80ae80", "tab_title": "Jak se prosadit s webem v konkurenci ostravských firem?", "tab_content": "<p>Kombinací kvalitního obsahu, rychlé orientace a cíleného SEO na služby a čtvrti, kde působíte. K tomu Google Firemní profil a případně PPC kampaně – všechno pod jednou střechou Yesmark.</p>"}, {"_id": "5a40122", "tab_title": "Budu si moci web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, fotky i nové stránky si upravíte sami a ukážeme vám, jak na to.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "ed8ffdd", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "1ef2be8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "8cb4a59", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "0983cb7", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_