lasses": "ww-num"}, "elements": []}, {"id": "7c21e82", "elType": "widget", "widgetType": "heading", "settings": {"title": "Struktura", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "e912f03", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Mapa stránek a cesta návštěvníka k poptávce.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "8427d97", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "cc463bf", "elType": "widget", "widgetType": "heading", "settings": {"title": "03", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "a8f235a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Obsah", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "37345ee", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Texty, které vysvětlí, prodávají a fungují ve vyhledávačích.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "a061071", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "d16911a", "elType": "widget", "widgetType": "heading", "settings": {"title": "04", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "e6328cb", "elType": "widget", "widgetType": "heading", "settings": {"title": "Wireframe", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "a799336", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Rozložení klíčových stránek ještě před grafikou.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "707dabf", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "8dfae48", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "e81bbc1", "elType": "widget", "widgetType": "heading", "settings": {"title": "Design", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "ab132e7", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Grafický návrh na míru vaší značce a oboru.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "ab29bca", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "0209642", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "889ce4b", "elType": "widget", "widgetType": "heading", "settings": {"title": "Vývoj", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "203c348", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>WordPress s Elementorem, nebo October CMS pro specifické projekty.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "6a06087", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "847eb59", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "3223a7a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Testování", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "ed6967e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Kontrola na mobilech, formulářů, měření i SEO.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "79e3011", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "3592c5d", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "be9b93e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Spuštění a rozvoj", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "435a232", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Spuštění, vyhodnocení a další vylepšování podle dat.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "60d5a75", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "040f34a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "9885ef2", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web na míru, nebo šablona?", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "2880ac5", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Šablona může stačit, pokud potřebujete rychle jednoduchou vizitku. Jakmile ale chcete, aby web přiváděl poptávky, odlišil vás od konkurence a dobře se umisťoval ve vyhledávání, vyplatí se tvorba webu na míru.</p><h3>Tvorba webových stránek na zakázku pro konkrétní obor</h3><p>Kadeřnictví potřebuje online rezervace, penzion fotky a dostupnost, stavební firma reference a poptávkový formulář. Pro více než 70 oborů jsme sepsali, co by měl web mít – najdete je v přehledu <a href=\"/weby-pro-obory/\">weby pro obory</a>.</p><h3>Kolik stojí web na míru</h3><p>Cena závisí na rozsahu, funkcích a podílu práce na obsahu. Weby začínají na 9 900 Kč, projekt na míru vždy naceníme individuálně. Více na stránce <a href=\"/kolik-stoji-web/\">Kolik stojí web</a>.</p><h3>Osobní přístup</h3><p>Po celou dobu máte jednoho člověka, se kterým vše řešíte. Žádné předávání mezi odděleními a žádné nejasnosti.</p>", "_css_classes": "ww-legaltext"}, "elements": []}]}]}, {"id": "af4def8", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "reference"}, "elements": [{"id": "b322698", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "33b6bda", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "9c89b42", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "33f4a60", "elType": "widget", "widgetType": "heading", "settings": {"title": "Reference", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "3d8a7fb", "elType": "widget", "widgetType": "heading", "settings": {"title": "Weby, na které jsme hrdí.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "d694f47", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Výběr realizací. Celé portfolio webů, e-shopů a kampaní najdete na Yesmark.eu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "e65c917", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-refs", "html_tag": "div"}, "elements": [{"id": "a615377", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "ccf992f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "3c1482d", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 28, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg", "alt": "Reference: web Konradt", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "0e2f78a", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "1a6db1f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "32e58e2", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · CNC obrábění", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "6cd3cc4", "elType": "widget", "widgetType": "heading", "settings": {"title": "Konradt", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "9112b27", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro společnost KONRADT jsme vytvořili nové webové stránky zaměřené na profesionální prezentaci služeb v oblasti CNC obrábění, montáže a zpracování kovů. Při realizaci jsme kladli důraz na moderní technický vzhled, přehledné představení výrobních možností společnosti a srozumitelnou prezentaci jednotlivých služeb.</p><p>Součástí realizace byla také optimalizace struktury a obsahu webu s ohledem na vyhledávače a lepší dohledatelnost služeb v oblasti CNC frézování, CNC soustružení, montážních prací a dodávek odlitků.</p>"}, "elements": []}, {"id": "d5e4f6f", "elType": "widget", "widgetType": "button", "settings": {"text": "konradt.cz", "link": {"url": "https://www.konradt.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "3396346", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "745379d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "89ab655", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 29, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-monika-velickova-web.jpg", "alt": "Reference: web Monika Veličková", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "9f48bb7", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "783e47d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "c0f33a7", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Reality Jeseníky", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "1fc0001", "elType": "widget", "widgetType": "heading", "settings": {"title": "Monika Veličková", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "102cd70", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro realitní makléřku Moniku Veličkovou jsme vytvořili nové webové stránky zaměřené na prezentaci nemovitostí a realitních služeb v Jeseníkách. Při realizaci jsme kladli důraz na moderní a osobitý design, přehlednou prezentaci nabízených nemovitostí a především na budování osobní značky, která staví na znalosti regionu, individuálním přístupu a zkušenostech s realitami i investicemi.</p>"}, "elements": []}, {"id": "3cb76d2", "elType": "widget", "widgetType": "button", "settings": {"text": "monikavelickova.cz", "link": {"url": "https://monikavelickova.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "83f5d14", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "2c75d8b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "03585f0", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 27, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-brincil-web.jpg", "alt": "Reference: web Břinčil", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "b191d4f", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "d288503", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "0416e1d", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Technika a služby", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "71471dc", "elType": "widget", "widgetType": "heading", "settings": {"title": "Břinčil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "c4dbe62", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Při realizaci webu pro firmu Břinčil jsme kladli důraz na moderní a přehledný design, snadnou orientaci návštěvníků a kvalitní prezentaci společnosti i její techniky. Nový web zároveň slouží jako podpůrná prezentace hlavní společnosti Břinčil &amp; Míka s.r.o., pro kterou jsme v minulosti rovněž realizovali kompletní online prezentaci.</p>"}, "elements": []}, {"id": "df02549", "elType": "widget", "widgetType": "button", "settings": {"text": "brincil.cz", "link": {"url": "https://brincil.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}]}, {"id": "23b6264", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row ww-refs-more ww-rv", "html_tag": "div"}, "elements": [{"id": "1ee3d25", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Další weby, e-shopy a kampaně najdete v portfoliu Yesmark.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "bd4de9f", "elType": "widget", "widgetType": "button", "settings": {"text": "Všechny reference", "link": {"url": "https://yesmark.eu/reference/?utm_source=wwwwww.cz&utm_medium=referral&utm_campaign=wwwwww_reference&utm_content=homepage_all", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--dark ww-btn--ext"}, "elements": []}]}]}]}, {"id": "724bd3f", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "cenik"}, "elements": [{"id": "98fb3d1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "e43654e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "4c3a12b", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "4bc79ef", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Tvorba webu na míru</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "0d9a59a", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na rozsahu, funkcích a grafice. Nabídku vám připravíme zdarma a nezávazně.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "aac9e0b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "e2e916f", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "be31902", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "c7eb0df", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – tvorba webu na míru", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "6756c0f", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "8beb294", "tab_title": "Jaký je rozdíl mezi webem na míru a šablonou?", "tab_content": "<p>Web na míru má strukturu, texty i design přizpůsobené vašemu podnikání. Šablona je univerzální a často vypadá podobně jako weby konkurence.</p>"}, {"_id": "2a87033", "tab_title": "Jak dlouho trvá tvorba webu na míru?", "tab_content": "<p>Podle rozsahu obvykle 3–8 týdnů. Harmonogram dostanete v nabídce.</p>"}, {"_id": "2f5f5b6", "tab_title": "Budu si moci web na míru upravovat sám?", "tab_content": "<p>Ano. I web na míru stavíme tak, abyste texty, fotky a stránky upravovali sami.</p>"}, {"_id": "d584b9e", "tab_title": "Děláte i weby na zakázku pro větší firmy?", "tab_content": "<p>Ano. Pro rozsáhlejší projekty spolupracujeme s týmem agentury Yesmark – od brandingu po kampaně.</p>"}, {"_id": "5984e13", "tab_title": "Co když nevím přesně, co chci?", "tab_content": "<p>To je v pořádku. Právě proto začínáme analýzou a konzultací, kde společně ujasníme cíle.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "d0e6277", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "b9fef2c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "08e2960", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "43f1f54", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "59ca16e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "fc5379a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Pojďme to probrat.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "221889f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Napište pár vět o svém podnikání nebo rovnou zavolejte. Ozvu se obvykle do jednoho pracovního dne.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "9c161dc", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes"