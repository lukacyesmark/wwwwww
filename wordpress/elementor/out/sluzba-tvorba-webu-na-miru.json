irection": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "dd2b11c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "c789e0a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "873729e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web na zakázku", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "a847ce0", "elType": "widget", "widgetType": "heading", "settings": {"title": "Co znamená web na míru", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "64557f6", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Web na míru není jen originální grafika. Je to web, jehož struktura odpovídá tomu, jak se vaši zákazníci rozhodují, a jehož texty mluví jejich jazykem.</p><p>Tvorba webu na míru proto začíná analýzou: kdo jsou vaši zákazníci, co hledají na Googlu, co nabízí konkurence a čím se odlišujete. Na tom stavíme strukturu, obsah i design.</p><p>Tvorba webových stránek na zakázku zároveň neznamená, že musíte platit za vývoj od nuly. Kombinujeme osvědčené technologie s designem a obsahem šitým přesně pro vás.</p>"}, "elements": []}]}, {"id": "1ae8de3", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "5801fce", "elType": "widget", "widgetType": "heading", "settings": {"title": "Na míru připravíme", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "e96c7dc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Strukturu podle vašich zákazníků</li><li>Texty v jazyce vašeho oboru</li><li>Design ve stylu vaší značky</li><li>Funkce, které opravdu použijete</li><li>SEO podle toho, co lidé hledají</li><li>Napojení na vaše nástroje</li><li>Administraci pro váš tým</li><li>Plán dalšího rozvoje</li></ul>"}, "elements": []}, {"id": "9f71e54", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "ff12872", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "8cdd71e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "611d506", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "2ab76dd", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "05d5e28", "elType": "widget", "widgetType": "heading", "settings": {"title": "Postup", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "96b1cb9", "elType": "widget", "widgetType": "heading", "settings": {"title": "Tvorba webu na míru v 8 krocích", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "71592cf", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Od analýzy po spuštění – každý krok přizpůsobený vašemu projektu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "5031f1a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c