irection": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "2925dc3", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "07db376", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "32f8024", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web na zakázku", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "f64fafd", "elType": "widget", "widgetType": "heading", "settings": {"title": "Co znamená web na míru", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "0569d03", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Web na míru není jen originální grafika. Je to web, jehož struktura odpovídá tomu, jak se vaši zákazníci rozhodují, a jehož texty mluví jejich jazykem.</p><p>Tvorba webu na míru proto začíná analýzou: kdo jsou vaši zákazníci, co hledají na Googlu, co nabízí konkurence a čím se odlišujete. Na tom stavíme strukturu, obsah i design.</p><p>Tvorba webových stránek na zakázku zároveň neznamená, že musíte platit za vývoj od nuly. Kombinujeme osvědčené technologie s designem a obsahem šitým přesně pro vás.</p>"}, "elements": []}]}, {"id": "919e4cd", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "ea265f0", "elType": "widget", "widgetType": "heading", "settings": {"title": "Na míru připravíme", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "a696b36", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Strukturu podle vašich zákazníků</li><li>Texty v jazyce vašeho oboru</li><li>Design ve stylu vaší značky</li><li>Funkce, které opravdu použijete</li><li>SEO podle toho, co lidé hledají</li><li>Napojení na vaše nástroje</li><li>Administraci pro váš tým</li><li>Plán dalšího rozvoje</li></ul>"}, "elements": []}, {"id": "e7f235b", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "0a4ac80", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "c996b19", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "ba67200", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "c990b32", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "0c650ab", "elType": "widget", "widgetType": "heading", "settings": {"title": "Postup", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "2144e52", "elType": "widget", "widgetType": "heading", "settings": {"title": "Tvorba webu na míru v 8 krocích", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "861aa39", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Od analýzy po spuštění – každý krok přizpůsobený vašemu projektu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "744b5a7", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c