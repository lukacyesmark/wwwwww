[]}]}]}, {"id": "f7328c4", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "8bec79c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "6954eb6", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">Co znamená web na míru</a><a href=\"#prehled\">Postup</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "29d66be", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "cec51c4", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "e75d7dc", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "fd05fd7", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web na zakázku", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "7e24005", "elType": "widget", "widgetType": "heading", "settings": {"title": "Co znamená web na míru", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "80c8d8b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Web na míru není jen originální grafika. Je to web, jehož struktura odpovídá tomu, jak se vaši zákazníci rozhodují, a jehož texty mluví jejich jazykem.</p><p>Tvorba webu na míru proto začíná analýzou: kdo jsou vaši zákazníci, co hledají na Googlu, co nabízí konkurence a čím se odlišujete. Na tom stavíme strukturu, obsah i design.</p><p>Tvorba webových stránek na zakázku zároveň neznamená, že musíte platit za vývoj od nuly. Kombinujeme osvědčené technologie s designem a obsahem šitým přesně pro vás.</p>"}, "elements": []}]}, {"id": "ab187ed", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "b6f4f81", "elType": "widget", "widgetType": "heading", "settings": {"title": "Na míru připravíme", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "2a820c9", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Strukturu podle vašich zákazníků</li><li>Texty v jazyce vašeho oboru</li><li>Design ve stylu vaší značky</li><li>Funkce, které opravdu použijete</li><li>SEO podle toho, co lidé hledají</li><li>Napojení na vaše nástroje</li><li>Administraci pro váš tým</li><li>Plán dalšího rozvoje</li></ul>"}, "elements": []}, {"id": "a84563f", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "4694fe9", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "0981c0a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "e36feb5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "eleme