[{"id": "d76aaef", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-tpl ww-tpl-header", "html_tag": "div"}, "elements": [{"id": "68e86d0", "elType": "widget", "widgetType": "template", "settings": {"template_id": "480"}, "elements": []}]}, {"id": "c823430", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark ww-phero ww-cityhero", "html_tag": "section", "_element_id": "uvod"}, "elements": [{"id": "d1a7005", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-hero-grid", "html_tag": "div"}, "elements": [{"id": "7a479a8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-hero-copy", "html_tag": "div"}, "elements": [{"id": "4ae6183", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><a href=\"/\">wwwwww.cz</a> / tvorba webu na míru</p>", "_css_classes": "ww-crumbs"}, "elements": []}, {"id": "44efd1c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web na zakázku", "header_size": "div", "_css_classes": "ww-eyebrow ww-rv"}, "elements": []}, {"id": "fa9ec0a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Tvorba webu na míru<span class=\"ww-red\">.</span>", "header_size": "h1", "_css_classes": "ww-h1 ww-rv"}, "elements": []}, {"id": "1260acd", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Tvorba webu na míru pro firmy, které nechtějí vypadat jako všichni ostatní. Struktura, texty i design přizpůsobené vašemu oboru, zákazníkům a cílům.</p>", "_css_classes": "ww-lead ww-mw ww-rv"}, "elements": []}, {"id": "30aa2a2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-