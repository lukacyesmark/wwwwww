[]}]}]}, {"id": "6af1647", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "a9020a1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "29780fc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">Co znamená web na míru</a><a href=\"#prehled\">Postup</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "47d2f07", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "4ec4f8c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "2f489fa", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "7e41330", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web na zakázku", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "096687a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Co znamená web na míru", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "b410b75", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Web na míru není jen originální grafika. Je to web, jehož struktura odpovídá tomu, jak se vaši zákazníci rozhodují, a jehož texty mluví jejich jazykem.</p><p>Tvorba webu na míru proto začíná analýzou: kdo jsou vaši zákazníci, co hledají na Googlu, co nabízí konkurence a čím se odlišujete. Na tom stavíme strukturu, obsah i design.</p><p>Tvorba webových stránek na zakázku zároveň neznamená, že musíte platit za vývoj od nuly. Kombinujeme osvědčené technologie s designem a obsahem šitým přesně pro vás.</p>"}, "elements": []}]}, {"id": "cf7d74a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "7a5cfe8", "elType": "widget", "widgetType": "heading", "settings": {"title": "Na míru připravíme", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "2a4862c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Strukturu podle vašich zákazníků</li><li>Texty v jazyce vašeho oboru</li><li>Design ve stylu vaší značky</li><li>Funkce, které opravdu použijete</li><li>SEO podle toho, co lidé hledají</li><li>Napojení na vaše nástroje</li><li>Administraci pro váš tým</li><li>Plán dalšího rozvoje</li></ul>"}, "elements": []}, {"id": "844e493", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "95cfc61", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "20c073c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "a0c346d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "eleme