ize": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "afc4a30", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Výběr realizací. Celé portfolio webů, e-shopů a kampaní najdete na Yesmark.eu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "f2291d5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-refs", "html_tag": "div"}, "elements": [{"id": "a9ba662", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "1ec1f84", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "26bee4c", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 28, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg", "alt": "Reference: web Konradt", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "79a1d3b", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "10cc32d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "4a414bc", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · CNC obrábění", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "4a14caf", "elType": "widget", "widgetType": "heading", "settings": {"title": "Konradt", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "7d3d51f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro společnost KONRADT jsme vytvořili nové webové stránky zaměřené na profesionální prezentaci služeb v oblasti CNC obrábění, montáže a zpracování kovů. Při realizaci jsme kladli důraz na moderní technický vzhled, přehledné představení výrobních možností společnosti a srozumitelnou prezentaci jednotlivých služeb.</p><p>Součástí realizace byla také optimalizace struktury a obsahu webu s ohledem na vyhledávače a lepší dohledatelnost služeb v oblasti CNC frézování, CNC soustružení, montážních prací a dodávek odlitků.</p>"}, "elements": []}, {"id": "edc9e3e", "elType": "widget", "widgetType": "button", "settings": {"text": "konradt.cz", "link": {"url": "https://www.konradt.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "c472d49", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "1c50628", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "d122ed1", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 29, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-monika-velickova-web.jpg", "alt": "Reference: web Monika Veličková", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "8220644", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "bd2320c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "0850b6e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Reality Jeseníky", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "a22fa2e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Monika Veličková", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "291cc51", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro realitní makléřku Moniku Veličkovou jsme vytvořili nové webové stránky zaměřené na prezentaci nemovitostí a realitních služeb v Jeseníkách. Při realizaci jsme kladli důraz na moderní a osobitý design, přehlednou prezentaci nabízených nemovitostí a především na budování osobní značky, která staví na znalosti regionu, individuálním přístupu a zkušenostech s realitami i investicemi.</p>"}, "elements": []}, {"id": "12cfc86", "elType": "widget", "widgetType": "button", "settings": {"text": "monikavelickova.cz", "link": {"url": "https://monikavelickova.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "ea5f1b8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "028dafe", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "6e797e0", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 27, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-brincil-web.jpg", "alt": "Reference: web Břinčil", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "7cd5662", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "32512da", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "fb1f34e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Technika a služby", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "abea5bf", "elType": "widget", "widgetType": "heading", "settings": {"title": "Břinčil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "3f1d462", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Při realizaci webu pro firmu Břinčil jsme kladli důraz na moderní a přehledný design, snadnou orientaci návštěvníků a kvalitní prezentaci společnosti i její techniky. Nový web zároveň slouží jako podpůrná prezentace hlavní společnosti Břinčil &amp; Míka s.r.o., pro kterou jsme v minulosti rovněž realizovali kompletní online prezentaci.</p>"}, "elements": []}, {"id": "ccdb16a", "elType": "widget", "widgetType": "button", "settings": {"text": "brincil.cz", "link": {"url": "https://brincil.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}]}, {"id": "f7c2027", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row ww-refs-more ww-rv", "html_tag": "div"}, "elements": [{"id": "9bdf62e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Další weby, e-shopy a kampaně najdete v portfoliu Yesmark.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "2d04316", "elType": "widget", "widgetType": "button", "settings": {"text": "Všechny reference", "link": {"url": "https://yesmark.eu/reference/?utm_source=wwwwww.cz&utm_medium=referral&utm_campaign=wwwwww_reference&utm_content=homepage_all", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--dark ww-btn--ext"}, "elements": []}]}]}]}, {"id": "a5f4e1c", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "cenik"}, "elements": [{"id": "2be60e7", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "157583f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "27cc693", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "bf519ec", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Web pro kosmetický salon</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "4bf5409", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na počtu stránek, funkcích (rezervace, e-shop, jazyky) a grafice. Nabídku vám připravíme zdarma.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "c52d14d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "2007994", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "3e6f88c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "67b641d", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – web pro kosmetický salon", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "51ba98a", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "8a252e6", "tab_title": "Má smysl dělat stránku pro každé ošetření?", "tab_content": "<p>Ano. Lidé hledají konkrétní ošetření a samostatná stránka s popisem, cenou a fotkami má mnohem větší šanci se zobrazit ve vyhledávání.</p>"}, {"_id": "6d25b22", "tab_title": "Můžu prodávat dárkové poukazy online?", "tab_content": "<p>Ano. Klient zaplatí kartou a poukaz mu automaticky přijde e-mailem – ideální před Vánoci a Valentýnem.</p>"}, {"_id": "73cb456", "tab_title": "Jak dlouho trvá vytvoření webu – kosmetický salon?", "tab_content": "<p>Jednodušší web bývá hotový za 2–4 týdny, rozsáhlejší s rezervacemi nebo e-shopem za 4–8 týdnů. Přesný harmonogram dostanete v nabídce.</p>"}, {"_id": "8432f8b", "tab_title": "Budu si web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, ceník, fotky i nové stránky změníte sami a ukážeme vám, jak na to.</p>"}, {"_id": "cdcc2b2", "tab_title": "Tvoříte weby jen v Jeseníku?", "tab_content": "<p>Sídlíme v Jeseníku, ale weby tvoříme pro klienty z celé České republiky. Spolupráce běží online, místní rádi potkáme osobně.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "2cdde16", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "82602fd", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "ac0e586", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "69265c8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "d5435c8", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptáv