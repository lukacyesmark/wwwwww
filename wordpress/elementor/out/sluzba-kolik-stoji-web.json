lements": []}]}]}, {"id": "bdceaf1", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "7c7ca6f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "6325dc4", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">Kolik stojí web u nás</a><a href=\"#prehled\">Co ovlivňuje cenu</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "698f472", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "1306a8e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "43c55ef", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "f528fac", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena a ceník", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "9ebe6cd", "elType": "widget", "widgetType": "heading", "settings": {"title": "Kolik stojí web u nás", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "3526856", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Jednodušší prezentační web u nás začíná na <strong>9 900 Kč</strong>. Za tu cenu dostanete moderní web pro mobil i počítač, kontaktní formulář, základní SEO a zaškolení do administrace.</p><p>Kolik stojí web s více stránkami, rezervacemi, jazykovými verzemi nebo e-shopem, spočítáme individuálně. Nabídku připravíme zdarma po krátkém hovoru – a vždy s jasným rozpisem, co v ceně je a co ne.</p><p>Neprodáváme balíčky, které nutí platit za funkce, které nepotřebujete. Cenu tvorby webových stránek skládáme podle skutečného rozsahu projektu.</p>"}, "elements": []}]}, {"id": "d5d2a47", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "79c5126", "elType": "widget", "widgetType": "heading", "settings": {"title": "V ceně je vždy", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "8c9b2f0", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Návrh struktury a designu</li><li>Web pro mobil, tablet i počítač</li><li>Kontaktní formulář a mapa</li><li>Základní SEO nastavení</li><li>Napojení na Google Analytics</li><li>Cookies lišta a GDPR</li><li>Zaškolení do administrace</li><li>Nabídka a konzultace zdarma</li></ul>"}, "elements": []}, {"id": "6788386", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "4e42b14", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "049d4b3", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "db4d9ab", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-hea