da", "elType": "widget", "widgetType": "heading", "settings": {"title": "02", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "baf8abc", "elType": "widget", "widgetType": "heading", "settings": {"title": "Texty", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "c64cb64", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Dodáte texty sami, nebo je máme napsat? Kvalitní obsah je práce, ale vyplatí se i pro SEO.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "d843b7b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "0745929", "elType": "widget", "widgetType": "heading", "settings": {"title": "03", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "046c3e6", "elType": "widget", "widgetType": "heading", "settings": {"title": "Fotky a grafika", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "e821eab", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Vlastní fotky, fotobanka, nebo focení na místě? Logo a vizuální styl jsou samostatná položka.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "edde375", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "943d090", "elType": "widget", "widgetType": "heading", "settings": {"title": "04", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "1aa62bd", "elType": "widget", "widgetType": "heading", "settings": {"title": "Funkce", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "b14d261", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Rezervace, kalkulačky, filtry, napojení na externí systémy – každá funkce přidá práci.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "87942bc", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "41a6c52", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "f5db03e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jazykové verze", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "e5e6f0d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Němčina nebo polština pro turisty znamená další texty i technické nastavení.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "61a4326", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "63e4cbd", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "3b3b554", "elType": "widget", "widgetType": "heading", "settings": {"title": "E-shop", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "df52cad", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Produkty, platby, doprava a obchodní podmínky – e-shop je samostatná kategorie projektu.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "1a74ad9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "5dc35b7", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "d77ff60", "elType": "widget", "widgetType": "heading", "settings": {"title": "Design na míru", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "e9d4feb", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Úprava osvědčeného rozložení je levnější než úplně originální grafika.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "b8b4d8e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "75b317a", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "669f0ea", "elType": "widget", "widgetType": "heading", "settings": {"title": "Správa po spuštění", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "6222faa", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Aktualizace, zálohy a úpravy můžete řešit sami, nebo je předat nám.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "490f7ae", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "d58e019", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "f587211", "elType": "widget", "widgetType": "heading", "settings": {"title": "Kolik stojí provoz webu a jde to levně?", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "69128c1", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>K ceně tvorby připočítejte provoz. Doména .cz stojí řádově stovky korun ročně, běžný hosting pro WordPress stovky až nižší tisíce korun ročně. Pokud chcete, aby se o aktualizace a zálohy staral někdo jiný, přidejte <a href=\"/sprava-webu/\">správu webu</a>.</p><h3>Tvorba webových stránek levně – kde ušetřit</h3><p>Ušetřit se dá rozumně: připravte si podklady, dodejte vlastní fotky, začněte s menším rozsahem a web rozšiřujte postupně. Neušetříte ale na obsahu a struktuře – web bez promyšlených textů nepřivede zákazníky, ať stál kolik chtěl.</p><h3>Proč nevolit nejlevnější nabídku</h3><p>Velmi levný web často znamená šablonu bez SEO, bez možnosti úprav, nebo web, ke kterému nemáte přístup. Při porovnání nabídek se ptejte, kdo bude web vlastnit, jak se upravuje a co se stane po spuštění.</p><h3>Kolik stojí web, který vydělává?</h3><p>Lepší otázka než „kolik stojí web“ je, kolik vám web přinese. Pokud díky němu získáte pár zakázek ročně navíc, vrátí se investice rychle. Proto navrhujeme každý web s jasnou cestou k poptávce.</p>", "_css_classes": "ww-legaltext"}, "elements": []}]}]}, {"id": "3000cf1", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "reference"}, "elements": [{"id": "b38a6a4", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "1a1122b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "6db89db", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "5d5d7c6", "elType": "widget", "widgetType": "heading", "settings": {"title": "Reference", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "2a38c66", "elType": "widget", "widgetType": "heading", "settings": {"title": "Weby, na které jsme hrdí.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "868d85d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Výběr realizací. Celé portfolio webů, e-shopů a kampaní najdete na Yesmark.eu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "6358c05", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-refs", "html_tag": "div"}, "elements": [{"id": "894ddcc", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "16ed4b8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "7c838c0", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 28, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg", "alt": "Reference: web Konradt", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "9e5768f", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "1eb75d5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "9b84693", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · CNC obrábění", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "f8925eb", "elType": "widget", "widgetType": "heading", "settings": {"title": "Konradt", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "25a8d70", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro společnost KONRADT jsme vytvořili nové webové stránky zaměřené na profesionální prezentaci služeb v oblasti CNC obrábění, montáže a zpracování kovů. Při realizaci jsme kladli důraz na moderní technický vzhled, přehledné představení výrobních možností společnosti a srozumitelnou prezentaci jednotlivých služeb.</p><p>Součástí realizace byla také optimalizace struktury a obsahu webu s ohledem na vyhledávače a lepší dohledatelnost služeb v oblasti CNC frézování, CNC soustružení, montážních prací a dodávek odlitků.</p>"}, "elements": []}, {"id": "9e3564b", "elType": "widget", "widgetType": "button", "settings": {"text": "konradt.cz", "link": {"url": "https://www.konradt.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "d6061c4", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "093f809", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "ac06945", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 29, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-monika-velickova-web.jpg", "alt": "Reference: web Monika Veličková", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "2264dc6", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "94a4acf", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "420ced5", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Reality Jeseníky", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "7b39070", "elType": "widget", "widgetType": "heading", "settings": {"title": "Monika Veličková", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "dc3fe27", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro realitní makléřku Moniku Veličkovou jsme vytvořili nové webové stránky zaměřené na prezentaci nemovitostí a realitních služeb v Jeseníkách. Při realizaci jsme kladli důraz na moderní a osobitý design, přehlednou prezentaci nabízených nemovitostí a především na budování osobní značky, která staví na znalosti regionu, individuálním přístupu a zkušenostech s realitami i investicemi.</p>"}, "elements": []}, {"id": "a6dc5d3", "elType": "widget", "widgetType": "button", "settings": {"text": "monikavelickova.cz", "link": {"url": "https://monikavelickova.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "e351890", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "18c0230", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "28c6197", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 27, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-brincil-web.jpg", "alt": "Reference: web Břinčil", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "31a4460", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "b8cc1e1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "d7ce7dd", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Technika a služby", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "200a2bd", "elType": "widget", "widgetType": "heading", "settings": {"title": "Břinčil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "d05839c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Při realizaci webu pro firmu Břinčil jsme kladli důraz na moderní a přehledný design, snadnou orientaci návštěvníků a kvalitní prezentaci společnosti i její techniky. Nový web zároveň slouží jako podpůrná prezentace hlavní společnosti Břinčil &amp; Míka s.r.o., pro kterou jsme v minulosti rovněž realizovali kompletní online prezentaci.</p>"}, "elements": []}, {"id": "e1267dd", "elType": "widget", "widgetType": "button", "settings": {"text": "brincil.cz", "link": {"url": "https://brincil.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}]}, {"id": "d212428", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row ww-refs-more ww-rv", "html_tag": "div"}, "elements": [{"id": "756869c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Další weby, e-shopy a kampaně najdete v portfoliu Yesmark.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "a512e36", "elType": "widget", "widgetType": "button", "settings": {"text": "Všechny reference", "link": {"url": "https://yesmark.eu/reference/?utm_source=wwwwww.cz&utm_medium=referral&utm_campaign=wwwwww_reference&utm_content=homepage_all", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--dark ww-btn--ext"}, "elements": []}]}]}]}, {"id": "655c59a", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "cenik"}, "elements": [{"id": "6ecfefc", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "4596d1b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "1a927a6", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "ff04d1e", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Kolik stojí web</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "287c524", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na rozsahu, funkcích a grafice. Nabídku vám připravíme zdarma a nezávazně.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "ea4bbdf", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "16d6df2", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "da853ca", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "913ac31", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – kolik stojí web", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "f32bd62", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "9d87d7b", "tab_title": "Kolik stojí jednoduchý web?", "tab_content": "<p>Jednoduchý prezentační web u nás začíná na 9 900 Kč. Přesnou cenu dostanete v nezávazné nabídce.</p>"}, {"_id": "184a8a0", "tab_title": "Kolik stojí web s e-shopem?", "tab_content": "<p>E-shop naceňujeme individuálně podle počtu produktů, plateb, dopravy a napojení. Více na stránce <a href=\"/tvorba-eshopu/\">tvorba e-shopu</a>.</p>"}, {"_id": "5748d42", "tab_title": "Platí se celá částka předem?", "tab_content": "<p>Ne. Obvykle se platí záloha při zahájení a zbytek po spuštění webu. Podmínky dostanete v nabídce.</p>"}, {"_id": "a77b5ef", "tab_title": "Kolik stojí úpravy po spuštění?", "tab_content": "<p>Drobné úpravy zvládnete sami v administraci. Větší změny naceníme předem, případně je zahrneme do správy webu.</p>"}, {"_id": "0832252", "tab_title": "Kolik stojí web pro živnostníka?", "tab_content": "<p>Pro většinu živnostníků stačí menší web do deseti stránek, který se vejde do nižších cenových hladin. Rozpočet probereme hned na začátku.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "43a1929", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "cae4b32", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "49374f4", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "87a022e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "e795e67", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "0c