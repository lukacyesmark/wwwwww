da", "elType": "widget", "widgetType": "heading", "settings": {"title": "02", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "1c4a711", "elType": "widget", "widgetType": "heading", "settings": {"title": "Texty", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "53d03a9", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Dodáte texty sami, nebo je máme napsat? Kvalitní obsah je práce, ale vyplatí se i pro SEO.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "e104903", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "806bbef", "elType": "widget", "widgetType": "heading", "settings": {"title": "03", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "240b288", "elType": "widget", "widgetType": "heading", "settings": {"title": "Fotky a grafika", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "944b616", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Vlastní fotky, fotobanka, nebo focení na místě? Logo a vizuální styl jsou samostatná položka.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "a798941", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "2fa1360", "elType": "widget", "widgetType": "heading", "settings": {"title": "04", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "bb254fc", "elType": "widget", "widgetType": "heading", "settings": {"title": "Funkce", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "a3b4d10", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Rezervace, kalkulačky, filtry, napojení na externí systémy – každá funkce přidá práci.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "0df2316", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "84e46a4", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "5f71d60", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jazykové verze", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "8f52479", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Němčina nebo polština pro turisty znamená další texty i technické nastavení.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "7b424cb", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "30fd444", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "95cf82e", "elType": "widget", "widgetType": "heading", "settings": {"title": "E-shop", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "29e5ab9", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Produkty, platby, doprava a obchodní podmínky – e-shop je samostatná kategorie projektu.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "f38eb04", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "6acbc9d", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "322cb51", "elType": "widget", "widgetType": "heading", "settings": {"title": "Design na míru", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "08d9657", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Úprava osvědčeného rozložení je levnější než úplně originální grafika.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "315e2df", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "99a0d86", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "6574997", "elType": "widget", "widgetType": "heading", "settings": {"title": "Správa po spuštění", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "30478b4", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Aktualizace, zálohy a úpravy můžete řešit sami, nebo je předat nám.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "ad81349", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "f92012b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "91c26d6", "elType": "widget", "widgetType": "heading", "settings": {"title": "Kolik stojí provoz webu a jde to levně?", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "fcba177", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>K ceně tvorby připočítejte provoz. Doména .cz stojí řádově stovky korun ročně, běžný hosting pro WordPress stovky až nižší tisíce korun ročně. Pokud chcete, aby se o aktualizace a zálohy staral někdo jiný, přidejte <a href=\"/sprava-webu/\">správu webu</a>.</p><h3>Tvorba webových stránek levně – kde ušetřit</h3><p>Ušetřit se dá rozumně: připravte si podklady, dodejte vlastní fotky, začněte s menším rozsahem a web rozšiřujte postupně. Neušetříte ale na obsahu a struktuře – web bez promyšlených textů nepřivede zákazníky, ať stál kolik chtěl.</p><h3>Proč nevolit nejlevnější nabídku</h3><p>Velmi levný web často znamená šablonu bez SEO, bez možnosti úprav, nebo web, ke kterému nemáte přístup. Při porovnání nabídek se ptejte, kdo bude web vlastnit, jak se upravuje a co se stane po spuštění.</p><h3>Kolik stojí web, který vydělává?</h3><p>Lepší otázka než „kolik stojí web“ je, kolik vám web přinese. Pokud díky němu získáte pár zakázek ročně navíc, vrátí se investice rychle. Proto navrhujeme každý web s jasnou cestou k poptávce.</p>", "_css_classes": "ww-legaltext"}, "elements": []}]}]}, {"id": "df0b5d9", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "reference"}, "elements": [{"id": "391da46", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "d52d910", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "e8f552c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "94e0a21", "elType": "widget", "widgetType": "heading", "settings": {"title": "Reference", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "d0fa467", "elType": "widget", "widgetType": "heading", "settings": {"title": "Weby, na které jsme hrdí.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "f720ba9", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Výběr realizací. Celé portfolio webů, e-shopů a kampaní najdete na Yesmark.eu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "42dc84a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-refs", "html_tag": "div"}, "elements": [{"id": "668b976", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "02fe1da", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "9a39005", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 28, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg", "alt": "Reference: web Konradt", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "c1246c4", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "64cd916", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "7cfcbd0", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · CNC obrábění", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "49b3579", "elType": "widget", "widgetType": "heading", "settings": {"title": "Konradt", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "532eaed", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro společnost KONRADT jsme vytvořili nové webové stránky zaměřené na profesionální prezentaci služeb v oblasti CNC obrábění, montáže a zpracování kovů. Při realizaci jsme kladli důraz na moderní technický vzhled, přehledné představení výrobních možností společnosti a srozumitelnou prezentaci jednotlivých služeb.</p><p>Součástí realizace byla také optimalizace struktury a obsahu webu s ohledem na vyhledávače a lepší dohledatelnost služeb v oblasti CNC frézování, CNC soustružení, montážních prací a dodávek odlitků.</p>"}, "elements": []}, {"id": "b024e58", "elType": "widget", "widgetType": "button", "settings": {"text": "konradt.cz", "link": {"url": "https://www.konradt.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "9781874", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "930e68b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "4c74014", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 29, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-monika-velickova-web.jpg", "alt": "Reference: web Monika Veličková", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "0114f3b", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "a677c65", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "8d4dea0", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Reality Jeseníky", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "e6b9ae3", "elType": "widget", "widgetType": "heading", "settings": {"title": "Monika Veličková", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "c0457c2", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro realitní makléřku Moniku Veličkovou jsme vytvořili nové webové stránky zaměřené na prezentaci nemovitostí a realitních služeb v Jeseníkách. Při realizaci jsme kladli důraz na moderní a osobitý design, přehlednou prezentaci nabízených nemovitostí a především na budování osobní značky, která staví na znalosti regionu, individuálním přístupu a zkušenostech s realitami i investicemi.</p>"}, "elements": []}, {"id": "89dc65c", "elType": "widget", "widgetType": "button", "settings": {"text": "monikavelickova.cz", "link": {"url": "https://monikavelickova.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "7dbcdd3", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "603e86a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "adf3312", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 27, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-brincil-web.jpg", "alt": "Reference: web Břinčil", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "b28dc88", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "c70f2ed", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "44eb122", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Technika a služby", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "fb1f8ed", "elType": "widget", "widgetType": "heading", "settings": {"title": "Břinčil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "fc16062", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Při realizaci webu pro firmu Břinčil jsme kladli důraz na moderní a přehledný design, snadnou orientaci návštěvníků a kvalitní prezentaci společnosti i její techniky. Nový web zároveň slouží jako podpůrná prezentace hlavní společnosti Břinčil &amp; Míka s.r.o., pro kterou jsme v minulosti rovněž realizovali kompletní online prezentaci.</p>"}, "elements": []}, {"id": "b549778", "elType": "widget", "widgetType": "button", "settings": {"text": "brincil.cz", "link": {"url": "https://brincil.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}]}, {"id": "8c0d3b2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row ww-refs-more ww-rv", "html_tag": "div"}, "elements": [{"id": "ce0d155", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Další weby, e-shopy a kampaně najdete v portfoliu Yesmark.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "1954f7e", "elType": "widget", "widgetType": "button", "settings": {"text": "Všechny reference", "link": {"url": "https://yesmark.eu/reference/?utm_source=wwwwww.cz&utm_medium=referral&utm_campaign=wwwwww_reference&utm_content=homepage_all", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--dark ww-btn--ext"}, "elements": []}]}]}]}, {"id": "7f68deb", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "cenik"}, "elements": [{"id": "5d1e94c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "f2671d2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "d7b861e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "394111b", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Kolik stojí web</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "e0ddc55", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na rozsahu, funkcích a grafice. Nabídku vám připravíme zdarma a nezávazně.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "fc594e8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "e7abdf9", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "1e9d13d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "9c8cd7c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – kolik stojí web", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "6134fa5", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "b376583", "tab_title": "Kolik stojí jednoduchý web?", "tab_content": "<p>Jednoduchý prezentační web u nás začíná na 9 900 Kč. Přesnou cenu dostanete v nezávazné nabídce.</p>"}, {"_id": "22b27b8", "tab_title": "Kolik stojí web s e-shopem?", "tab_content": "<p>E-shop naceňujeme individuálně podle počtu produktů, plateb, dopravy a napojení. Více na stránce <a href=\"/tvorba-eshopu/\">tvorba e-shopu</a>.</p>"}, {"_id": "4e82b22", "tab_title": "Platí se celá částka předem?", "tab_content": "<p>Ne. Obvykle se platí záloha při zahájení a zbytek po spuštění webu. Podmínky dostanete v nabídce.</p>"}, {"_id": "e1389cc", "tab_title": "Kolik stojí úpravy po spuštění?", "tab_content": "<p>Drobné úpravy zvládnete sami v administraci. Větší změny naceníme předem, případně je zahrneme do správy webu.</p>"}, {"_id": "b8855e3", "tab_title": "Kolik stojí web pro živnostníka?", "tab_content": "<p>Pro většinu živnostníků stačí menší web do deseti stránek, který se vejde do nižších cenových hladin. Rozpočet probereme hned na začátku.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "625bb76", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "c027e79", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "e0c504e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "0149c05", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "6359bf3", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "7a