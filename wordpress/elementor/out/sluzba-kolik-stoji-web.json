lements": []}]}]}, {"id": "d12adb5", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "117060b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "3af910b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">Kolik stojí web u nás</a><a href=\"#prehled\">Co ovlivňuje cenu</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "87dab45", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "ff6c963", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "fd5e3e8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "b53665b", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena a ceník", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "23e719e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Kolik stojí web u nás", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "66ae314", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Jednodušší prezentační web u nás začíná na <strong>9 900 Kč</strong>. Za tu cenu dostanete moderní web pro mobil i počítač, kontaktní formulář, základní SEO a zaškolení do administrace.</p><p>Kolik stojí web s více stránkami, rezervacemi, jazykovými verzemi nebo e-shopem, spočítáme individuálně. Nabídku připravíme zdarma po krátkém hovoru – a vždy s jasným rozpisem, co v ceně je a co ne.</p><p>Neprodáváme balíčky, které nutí platit za funkce, které nepotřebujete. Cenu tvorby webových stránek skládáme podle skutečného rozsahu projektu.</p>"}, "elements": []}]}, {"id": "6e1cbd9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "526c004", "elType": "widget", "widgetType": "heading", "settings": {"title": "V ceně je vždy", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "f8edf6b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Návrh struktury a designu</li><li>Web pro mobil, tablet i počítač</li><li>Kontaktní formulář a mapa</li><li>Základní SEO nastavení</li><li>Napojení na Google Analytics</li><li>Cookies lišta a GDPR</li><li>Zaškolení do administrace</li><li>Nabídka a konzultace zdarma</li></ul>"}, "elements": []}, {"id": "d3ef339", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "5fe849a", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "2d441f9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "201dd2c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-hea