lasses": "ww-num"}, "elements": []}, {"id": "2e7c2aa", "elType": "widget", "widgetType": "heading", "settings": {"title": "Fotky a grafika", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "0257274", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Vlastní fotky, fotobanka, nebo focení na místě? Logo a vizuální styl jsou samostatná položka.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "4afb010", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "655c32c", "elType": "widget", "widgetType": "heading", "settings": {"title": "04", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "d5a3c46", "elType": "widget", "widgetType": "heading", "settings": {"title": "Funkce", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "3ffc657", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Rezervace, kalkulačky, filtry, napojení na externí systémy – každá funkce přidá práci.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "f9bfd8f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "06b4321", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "f1cd118", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jazykové verze", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "93cd4aa", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Němčina nebo polština pro turisty znamená další texty i technické nastavení.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "d0aaef3", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "7899526", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "fff53e9", "elType": "widget", "widgetType": "heading", "settings": {"title": "E-shop", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "6cc5c21", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Produkty, platby, doprava a obchodní podmínky – e-shop je samostatná kategorie projektu.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "d5c4313", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "2f630f9", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "61275b0", "elType": "widget", "widgetType": "heading", "settings": {"title": "Design na míru", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "234e4ba", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Úprava osvědčeného rozložení je levnější než úplně originální grafika.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "3eab6cb", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "cbb2ce6", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "e3829cf", "elType": "widget", "widgetType": "heading", "settings": {"title": "Správa po spuštění", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "d250d34", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Aktualizace, zálohy a úpravy můžete řešit sami, nebo je předat nám.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "5bbe884", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "7f1200a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "4ccfdc1", "elType": "widget", "widgetType": "heading", "settings": {"title": "Kolik stojí provoz webu a jde to levně?", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "848be0e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>K ceně tvorby připočítejte provoz. Doména .cz stojí řádově stovky korun ročně, běžný hosting pro WordPress stovky až nižší tisíce korun ročně. Pokud chcete, aby se o aktualizace a zálohy staral někdo jiný, přidejte <a href=\"/sprava-webu/\">správu webu</a>.</p><h3>Tvorba webových stránek levně – kde ušetřit</h3><p>Ušetřit se dá rozumně: připravte si podklady, dodejte vlastní fotky, začněte s menším rozsahem a web rozšiřujte postupně. Neušetříte ale na obsahu a struktuře – web bez promyšlených textů nepřivede zákazníky, ať stál kolik chtěl.</p><h3>Proč nevolit nejlevnější nabídku</h3><p>Velmi levný web často znamená šablonu bez SEO, bez možnosti úprav, nebo web, ke kterému nemáte přístup. Při porovnání nabídek se ptejte, kdo bude web vlastnit, jak se upravuje a co se stane po spuštění.</p><h3>Kolik stojí web, který vydělává?</h3><p>Lepší otázka než „kolik stojí web“ je, kolik vám web přinese. Pokud díky němu získáte pár zakázek ročně navíc, vrátí se investice rychle. Proto navrhujeme každý web s jasnou cestou k poptávce.