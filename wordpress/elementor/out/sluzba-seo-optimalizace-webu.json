 "elements": []}]}]}, {"id": "b7a7dda", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "34e7091", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "49f2d45", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">SEO začíná už při tvorbě webu</a><a href=\"#prehled\">Postup</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "ef172dd", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "bbc320b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "6b92c93", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "be4947f", "elType": "widget", "widgetType": "heading", "settings": {"title": "SEO", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "d359ee4", "elType": "widget", "widgetType": "heading", "settings": {"title": "SEO začíná už při tvorbě webu", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "cf8d77a", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Nejlevnější SEO je to, které se udělá hned při tvorbě webu. Promyšlená struktura, správné nadpisy, popisky a interní odkazy dají webu dobrý základ, na kterém se dá stavět.</p><p>Proto u nás tvorba webových stránek a SEO jdou ruku v ruce. Každý web, který postavíme, má základní SEO optimalizaci v ceně. Pro větší ambice nabízíme navazující optimalizaci a obsah.</p><p>SEO optimalizace webu ale není kouzlo. Výsledky přicházejí postupně, v řádu týdnů až měsíců. Slibujeme poctivou práci, ne první místo na Googlu za týden.</p>"}, "elements": []}]}, {"id": "54f46b2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "2b70587", "elType": "widget", "widgetType": "heading", "settings": {"title": "Co optimalizujeme", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "1c45a1c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Strukturu webu a interní odkazy</li><li>Titulky a meta popisky</li><li>Nadpisy a obsah stránek</li><li>Alt texty obrázků</li><li>Sitemapu a indexaci</li><li>Strukturovaná data</li><li>Google Firemní profil</li><li>Měření v Search Console</li></ul>"}, "elements": []}, {"id": "20c468f", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "f083397", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "e68876b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "b2d7043", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"i