 "elements": []}]}]}, {"id": "6ba44fe", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "2c669f9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "f3babad", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">SEO začíná už při tvorbě webu</a><a href=\"#prehled\">Postup</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "2d6dca2", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "a1f63ba", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "313e17a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "e82c1e0", "elType": "widget", "widgetType": "heading", "settings": {"title": "SEO", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "8895712", "elType": "widget", "widgetType": "heading", "settings": {"title": "SEO začíná už při tvorbě webu", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "47b411d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Nejlevnější SEO je to, které se udělá hned při tvorbě webu. Promyšlená struktura, správné nadpisy, popisky a interní odkazy dají webu dobrý základ, na kterém se dá stavět.</p><p>Proto u nás tvorba webových stránek a SEO jdou ruku v ruce. Každý web, který postavíme, má základní SEO optimalizaci v ceně. Pro větší ambice nabízíme navazující optimalizaci a obsah.</p><p>SEO optimalizace webu ale není kouzlo. Výsledky přicházejí postupně, v řádu týdnů až měsíců. Slibujeme poctivou práci, ne první místo na Googlu za týden.</p>"}, "elements": []}]}, {"id": "c215d4a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "61f36e6", "elType": "widget", "widgetType": "heading", "settings": {"title": "Co optimalizujeme", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "310f0a3", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Strukturu webu a interní odkazy</li><li>Titulky a meta popisky</li><li>Nadpisy a obsah stránek</li><li>Alt texty obrázků</li><li>Sitemapu a indexaci</li><li>Strukturovaná data</li><li>Google Firemní profil</li><li>Měření v Search Console</li></ul>"}, "elements": []}, {"id": "18a89e3", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "14f2132", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "023048e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "f3f50ed", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"i