-checklist\"><li>Strukturu webu a interní odkazy</li><li>Titulky a meta popisky</li><li>Nadpisy a obsah stránek</li><li>Alt texty obrázků</li><li>Sitemapu a indexaci</li><li>Strukturovaná data</li><li>Google Firemní profil</li><li>Měření v Search Console</li></ul>"}, "elements": []}, {"id": "c3ffc13", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "36773c6", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "bd67af8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "341f243", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "742192f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "85f6a8b", "elType": "widget", "widgetType": "heading", "settings": {"title": "Postup", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "406a75f", "elType": "widget", "widgetType": "heading", "settings": {"title": "SEO optimalizace webu v 8 krocích", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "47cdde8", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Jak postupujeme, aby váš web získal návštěvnost z vyhledávání.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "a5322ef", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-grid4", "ht