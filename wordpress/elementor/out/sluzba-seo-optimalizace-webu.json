ard ww-rv", "html_tag": "div"}, "elements": [{"id": "f777c5f", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "dee560f", "elType": "widget", "widgetType": "heading", "settings": {"title": "On-page SEO", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "9958a08", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Titulky, popisky, nadpisy, alt texty a interní odkazy.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "ea2ecc8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "0a38c71", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "8d940d2", "elType": "widget", "widgetType": "heading", "settings": {"title": "Lokální SEO", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "847d45c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Google Firemní profil, recenze a lokální stránky.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "40b8eb2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "1ed7c14", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "f84f340", "elType": "widget", "widgetType": "heading", "settings": {"title": "Indexace", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "1deb08f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Sitemapa, Search Console a kontrola chyb.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "01b81c1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "335d731", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "ca63763", "elType": "widget", "widgetType": "heading", "settings": {"title": "Vyhodnocení", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "72f8309", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Sledujeme pozice a návštěvnost a obsah dále ladíme.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "df3afae", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "4413757", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "04c688c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Lokální SEO pro firmy z regionu", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "202a8f3", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pokud obsluhujete zákazníky v konkrétním městě, je lokální SEO nejrychlejší cesta k výsledkům. Optimalizujeme Google Firemní profil, vytváříme stránky pro jednotlivá města a pomáháme se sbíráním recenzí.</p><h3>Tvorba webových stránek se SEO od začátku</h3><p>U nových webů je SEO optimalizace webu součástí tvorby. U stávajících webů začínáme auditem a navrhneme, co upravit. Někdy stačí doplnit obsah, jindy se vyplatí <a href=\"/redesign-webu/\">redesign webu</a>.</p><h3>Obsah, který přivádí zákazníky</h3><p>Pro desítky oborů jsme sepsali, co by měl web obsahovat – podívejte se do přehledu <a href=\"/weby-pro-obory/\">weby pro obory</a>. Stejný přístup použijeme i pro váš web.</p><h3>SEO, PPC a sociální sítě</h3><p>SEO je dlouhodobá investice. Pokud potřebujete výsledky hned, doplníme ho PPC kampaněmi s týmem agentury Yesmark.</p>", "_css_classes": "ww-legaltext"}, "elements": []}]}]}, {"id": "54c6687", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "reference"}, "elements": [{"id": "08ac23d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "fb5cd9a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "c28ac14", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "59ad577", "elType": "widget", "widgetType": "heading", "settings": {"title": "Reference", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "f101543", "elType": "widget", "widgetType": "heading", "settings": {"title": "Weby, na které jsme hrdí.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "4dc2249", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Výběr realizací. Celé portfolio webů, e-shopů a kampaní najdete na Yesmark.eu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "66e3a0f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-refs", "html_tag": "div"}, "elements": [{"id": "a25b631", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "5216e9c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "b988206", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 28, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg", "alt": "Reference: web Konradt", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "15c55cc", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "c7dfcdd", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "3a38b22", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · CNC obrábění", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "ae69242", "elType": "widget", "widgetType": "heading", "settings": {"title": "Konradt", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "45a0b33", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro společnost KONRADT jsme vytvořili nové webové stránky zaměřené na profesionální prezentaci služeb v oblasti CNC obrábění, montáže a zpracování kovů. Při realizaci jsme kladli důraz na moderní technický vzhled, přehledné představení výrobních možností společnosti a srozumitelnou prezentaci jednotlivých služeb.</p><p>Součástí realizace byla také optimalizace struktury a obsahu webu s ohledem na vyhledávače a lepší dohledatelnost služeb v oblasti CNC frézování, CNC soustružení, montážních prací a dodávek odlitků.</p>"}, "elements": []}, {"id": "10e4666", "elType":