 "elements": []}]}]}, {"id": "2dc03b9", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "debbeb5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "54bdaf3", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">SEO začíná už při tvorbě webu</a><a href=\"#prehled\">Postup</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "c833467", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "eb83d53", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "9ecb046", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "76fe3e0", "elType": "widget", "widgetType": "heading", "settings": {"title": "SEO", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "0e423cd", "elType": "widget", "widgetType": "heading", "settings": {"title": "SEO začíná už při tvorbě webu", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "a083a9b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Nejlevnější SEO je to, které se udělá hned při tvorbě webu. Promyšlená struktura, správné nadpisy, popisky a interní odkazy dají webu dobrý základ, na kterém se dá stavět.</p><p>Proto u nás tvorba webových stránek a SEO jdou ruku v ruce. Každý web, který postavíme, má základní SEO optimalizaci v ceně. Pro větší ambice nabízíme navazující optimalizaci a obsah.</p><p>SEO optimalizace webu ale není kouzlo. Výsledky přicházejí postupně, v řádu týdnů až měsíců. Slibujeme poctivou práci, ne první místo na Googlu za týden.</p>"}, "elements": []}]}, {"id": "cdd43c1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "7c5955c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Co optimalizujeme", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "d854efd", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Strukturu webu a interní odkazy</li><li>Titulky a meta popisky</li><li>Nadpisy a obsah stránek</li><li>Alt texty obrázků</li><li>Sitemapu a indexaci</li><li>Strukturovaná data</li><li>Google Firemní profil</li><li>Měření v Search Console</li></ul>"}, "elements": []}, {"id": "b370283", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "df6aacc", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "ab182cf", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "af53102", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"i