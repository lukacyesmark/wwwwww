afae75", "tab_title": "Budu si moci web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, fotky i nové stránky si upravíte sami a ukážeme vám, jak na to.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "a0b06a9", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "ceba4fa", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "38b3043", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "7fdad16", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "f040dc3", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "fe227af", "elType": "widget", "widgetType": "heading", "settings": {"title": "Nový web pro vaši firmu z Třince?", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "6bf1aca", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Tvorba webových stránek Třinec začíná jednou zprávou. Napište pár vět nebo rovnou zavolejte – ozvu se obvykle do jednoho pracovního dne.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "007cc70", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-contact", "html_tag": "div"}, "elements": [{"id": "6834f31", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "colu