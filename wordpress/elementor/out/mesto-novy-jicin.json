, "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "8befb2b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "7f46ce1", "elType": "widget", "widgetType": "heading", "settings": {"title": "Ceník · Nový Jičín", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "02b145d", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Tvorba webových stránek Nový Jičín</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "4387e59", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná částka se odvíjí od rozsahu, funkcí a grafického zpracování. Každý projekt naceňujeme individuálně a férově.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "a8f095f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "7fee021", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "b81ae42", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "4d8f3d7", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – tvorba webových stránek Nový Jičín", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "98be40a", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "bf610d0", "tab_title": "Kolik stojí tvorba webových stránek v Novém Jičíně?", "tab_content": "<p>Tvorba webových stránek Nový Jičín začíná na 9 900 Kč. Konečná cena záleží na rozsahu, funkcích a grafickém zpracování. Po krátké konzultaci dostanete nezávaznou nabídku zdarma.</p>"}, {"_id": "70f283d", "tab_title": "Musím za vámi jezdit do Jeseníku?", "tab_content": "<p>Nemusíte. Konzultace, návrhy i předání webu zvládneme online – telefonem, videohovorem a e-mailem. Když je to potřeba, rádi se potkáme i osobně.</p>"}, {"_id": "ebc042c", "tab_title": "Pomůžete, aby nás našli zákazníci z Nového Jičína?", "tab_content": "<p>Ano. Web postavíme s ohledem na lokální SEO pro Nový Jičín – obsah zaměřený na vaše služby a lokalitu, Google Firemní profil a technické SEO od prvního dne.</p>"}, {"_id": "162a751", "tab_title": "Zvládnete e-shop pro řemeslnou výrobu z Nového Jičína?", "tab_content": "<p>Ano. Navrhneme e-shop, který vynikne fotkami, příběhem výrobků a jednoduchým nákupem – včetně plateb a dopravy.</p>"}, {"_id": "d0fb3fa", "tab_title": "Budu si moci web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, fotky i nové stránky si upravíte sami a ukážeme vám, jak na to.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "c8e09bf", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "6ecb078", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "ea16c90", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "916e29a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "918c298", "elType"