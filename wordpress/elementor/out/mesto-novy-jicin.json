ings": {"title": "Monika Veličková", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "ee0111f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro realitní makléřku Moniku Veličkovou jsme vytvořili nové webové stránky zaměřené na prezentaci nemovitostí a realitních služeb v Jeseníkách. Při realizaci jsme kladli důraz na moderní a osobitý design, přehlednou prezentaci nabízených nemovitostí a především na budování osobní značky, která staví na znalosti regionu, individuálním přístupu a zkušenostech s realitami i investicemi.</p>"}, "elements": []}, {"id": "cf83a1a", "elType": "widget", "widgetType": "button", "settings": {"text": "monikavelickova.cz", "link": {"url": "https://monikavelickova.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "b261f03", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "0f6a923", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "2c7b7b3", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 27, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-brincil-web.jpg", "alt": "Reference: web Břinčil", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "c071aa5", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "2e08ecc", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "fa876a0", "elType": "widget", "widgetType": "heading", "settings"