": "04f2da1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "b506c02", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "d19915c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Ceník · Šumperk", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "0b31a1e", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Tvorba webových stránek Šumperk</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "925d0c0", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná částka se odvíjí od rozsahu, funkcí a grafického zpracování. Každý projekt naceňujeme individuálně a férově.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "324a55b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "177e9b7", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "c3522d1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "a5d83b8", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – tvorba webových stránek Šumperk", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "0e94c85", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "09dd133", "tab_title": "Kolik stojí tvorba webových stránek v Šumperku?", "tab_content": "<p>Tvorba webových stránek Šumperk začíná na 9 900 Kč. Konečná cena záleží na rozsahu, funkcích a grafickém zpracování. Po krátké konzultaci dostanete nezávaznou nabídku zdarma.</p>"}, {"_id": "4246418", "tab_title": "Musím za vámi jezdit do Jeseníku?", "tab_content": "<p>Nemusíte. Konzultace, návrhy i předání webu zvládneme online – telefonem, videohovorem a e-mailem. Když je to potřeba, rádi se potkáme i osobně.</p>"}, {"_id": "ad6a768", "tab_title": "Pomůžete, aby nás našli zákazníci ze Šumperka?", "tab_content": "<p>Ano. Web postavíme s ohledem na lokální SEO pro Šumperk – obsah zaměřený na vaše služby a lokalitu, Google Firemní profil a technické SEO od prvního dne.</p>"}, {"_id": "671f9ca", "tab_title": "Uděláte web pro penzion nebo apartmány v okolí Šumperka?", "tab_content": "<p>Ano, to je naše parketa. Web s kvalitními fotkami, přehledem pokojů a cen, rezervačním formulářem a jazykovými verzemi (DE, PL, EN), aby hosté rezervovali napřímo.</p>"}, {"_id": "ea0b1c2", "tab_title": "Budu si moci web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, fotky i nové stránky si upravíte sami a ukážeme vám, jak na to.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "77c16a7", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "94bf30e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "ff97e77", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "a060f72", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "w