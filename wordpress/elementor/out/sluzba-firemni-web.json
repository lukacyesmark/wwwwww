 "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "5a49ea6", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "d0f99bc", "elType": "widget", "widgetType": "heading", "settings": {"title": "Měření", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "8c75adc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Víte, kolik poptávek web přinesl.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "ed97fae", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "e3b479f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "fa098db", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jak postavit firemní web, který funguje", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "d0014cc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Firemní web stavíme podle toho, jak se vaši zákazníci rozhodují. Výrobní firma potřebuje ukázat technologie a kapacity, služba reference a rychlý kontakt, ubytování fotky a rezervace. Inspiraci pro desítky oborů najdete v přehledu <a href=\"/weby-pro-obory/\">weby pro obory</a>.</p><h3>Firemní web, nebo e-shop?</h3><p>Pokud prodáváte produkty online, zvažte <a href=\"/tvorba-eshopu/\">tvorbu e-shopu</a>. Pokud nabízíte služby nebo zakázkovou výrobu, firemní web s poptávkovým formulářem je obvykle lepší volba.</p><h3>Kolik stojí firemní web</h3><p>Firemní web u nás začíná na 9 900 Kč. Cena závisí na počtu stránek, funkcích a podílu práce na textech. Více na stránce <a href=\"/kolik-stoji-web/\">Kolik stojí web</a>.</p><h3>Jednotná značka</h3><p>S agenturou Yesmark navážeme logem, vizuálním stylem, tiskovinami i reklamními předměty, aby firma působila jednotně online i offline.</p>", "_css_classes": "ww-legaltext"}, "elements": []}]}]}, {"id": "67a2b01", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "reference"}, "elements": [{"id": "2143fb7", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "1cdf410", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "80c2e7d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "64aa771", "elType": "widget", "widgetType": "heading", "settings": {"title": "Reference", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "f1fe5f0", "elType": "widget", "widgetType": "heading", "settings": {"title": "Weby, na které jsme hrdí.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "8ac2a2c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Výběr realizací. Celé portfolio webů, e-shopů a kampaní najdete na Yesmark.eu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "35b492e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-refs", "html_tag": "div"}, "elements": [{"id": "1dbc4e9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "c9675ec", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "facd1e2", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 28, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg", "alt": "Reference: web Konradt", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "145cfab", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "62e6202", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "7d38118", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · CNC obrábění", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "d29b107", "elType": "widget", "widgetType": "heading", "settings": {"title": "Konradt", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "359eb7e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro společnost KONRADT jsme vytvořili nové webové stránky zaměřené na profesionální prezentaci služeb v oblasti CNC obrábění, montáže a zpracování kovů. Při realizaci jsme kladli důraz na moderní technický vzhled, přehledné představení výrobních možností společnosti a srozumitelnou prezentaci jednotlivých služeb.</p><p>Součástí realizace byla také optimalizace struktury a obsahu webu s ohledem na vyhledávače a lepší dohledatelnost služeb v oblasti CNC frézování, CNC soustružení, montážních prací a dodávek odlitků.</p>"}, "elements": []}, {"id": "536978e", "elType": "widget", "widgetType": "button", "settings": {"text": "konradt.cz", "link": {"url": "https://www.konradt.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "4f41a21", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "b09a9a6", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "d73923b", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 29, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-monika-velickova-web.jpg", "alt": "Reference: web Monika Veličková", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "8f4e157", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "8bbe50c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "248fea4", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Reality Jeseníky", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "d31cc51", "elType": "widget", "widgetType": "heading", "settings": {"title": "Monika Veličková", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "c6805b6", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro realitní makléřku Moniku Veličkovou jsme vytvořili nové webové stránky zaměřené na prezentaci nemovitostí a realitních služeb v Jeseníkách. Při realizaci jsme kladli důraz na moderní a osobitý design, přehlednou prezentaci nabízených nemovitostí a především na budování osobní značky, která staví na znalosti regionu, individuálním přístupu a zkušenostech s realitami i investicemi.</p>"}, "elements": []}, {"id": "dcce7cb", "elType": "widget", "widgetType": "button", "settings": {"text": "monikavelickova.cz", "link": {"url": "https://monikavelickova.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "1b2db0e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "2513b00", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "0cbf989", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 27, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-brincil-web.jpg", "alt": "Reference: web Břinčil", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "8535c99", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "6989822", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "aba2c3c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Technika a služby", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "c2220eb", "elType": "widget", "widgetType": "heading", "settings": {"title": "Břinčil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "5c75ad5", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Při realizaci webu pro firmu Břinčil jsme kladli důraz na moderní a přehledný design, snadnou orientaci návštěvníků a kvalitní prezentaci společnosti i její techniky. Nový web zároveň slouží jako podpůrná prezentace hlavní společnosti Břinčil &amp; Míka s.r.o., pro kterou jsme v minulosti rovněž realizovali kompletní online prezentaci.</p>"}, "elements": []}, {"id": "e05c456", "elType": "widget", "widgetType": "button", "settings": {"text": "brincil.cz", "link": {"url": "https://brincil.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}]}, {"id": "0268f78", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row ww-refs-more ww-rv", "html_tag": "div"}, "elements": [{"id": "9b8cf93", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Další weby, e-shopy a kampaně najdete v portfoliu Yesmark.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "27d186a", "elType": "widget", "widgetType": "button", "settings": {"text": "Všechny reference", "link": {"url": "https://yesmark.eu/reference/?utm_source=wwwwww.cz&utm_medium=referral&utm_campaign=wwwwww_reference&utm_content=homepage_all", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--dark ww-btn--ext"}, "elements": []}]}]}]}, {"id": "ef30ff0", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "cenik"}, "elements": [{"id": "d8419c4", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "70ae9ae", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "d078532", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "caaabfc", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Firemní web</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "c2cb77b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na rozsahu, funkcích a grafice. Nabídku vám připravíme zdarma a nezávazně.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "2390d10", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "0dafb67", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "c971b80", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "cc7dc1f", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – firemní web", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "17c07aa", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "788226a", "tab_title": "Kolik stránek by měl mít firemní web?", "tab_content": "<p>Většině firem stačí 5–15 stránek: úvod, služby, reference, o firmě a kontakt. Každá klíčová služba si zaslouží vlastní stránku.</p>"}, {"_id": "e4eb5cb", "tab_title": "Co když nemáme texty?", "tab_content": "<p>Pomůžeme s nimi. Stačí nám informace o firmě a službách, texty připravíme a doladíme s vámi.</p>"}, {"_id": "1a90ff8", "tab_title": "Potřebujeme profesionální fotky?", "tab_content": "<p>Vlastní fotky působí výrazně důvěryhodněji než fotobanka. Pokud je nemáte, doporučíme fotografa.</p>"}, {"_id": "21eaf1a", "tab_title": "Můžeme mít web ve více jazycích?", "tab_content": "<p>Ano. Jazykové verze přidáme hned, nebo později.</p>"}, {"_id": "521af4e", "tab_title": "Jak dlouho trvá vytvoření firemního webu?", "tab_content": "<p>Obvykle 2–6 týdnů podle rozsahu a podkladů.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "55d2c4d", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "6ae97dc", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "a3757e1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "9736699", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "65be89e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "b0329cb", "elType": "widget", "widgetType": "heading", "settings": {"title": "Pojďme to probrat.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "6b347dc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Napište pár vět o svém podnikání nebo rovnou zavolejte. Ozvu se obvykle do jednoho pracovního dne.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "de20108", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-contact", "html_tag": "div"}, "elements": [{"id": "e3574ba", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-person ww-rv", "html_tag": "div"}, "elements