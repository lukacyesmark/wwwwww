, {"id": "a22c5c3", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Firemní web</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "658ef89", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na rozsahu, funkcích a grafice. Nabídku vám připravíme zdarma a nezávazně.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "a591f9a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "07eacf3", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "78da229", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "1b4ab48", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – firemní web", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "4d5a026", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "b4c9347", "tab_title": "Kolik stránek by měl mít firemní web?", "tab_content": "<p>Většině firem stačí 5–15 stránek: úvod, služby, reference, o firmě a kontakt. Každá klíčová služba si zaslouží vlastní stránku.</p>"}, {"_id": "de72444", "tab_title": "Co když nemáme texty?", "tab_content": "<p>Pomůžeme s nimi. Stačí nám informace o firmě a službách, texty připravíme a doladíme s vámi.</p>"}, {"_id": "e1f4596", "tab_title": "Potřebujeme profesionální fotky?", "tab_content": "<p>Vlastní fotky působí výrazně důvěryhodněji než fotobanka. Pokud je nemáte, doporučíme fotografa.</p>"}, {"_id": "b392d1c", "tab_title": "Můžeme mít web ve více jazycích?", "tab_content": "<p>Ano. Jazykové verze přidáme hned, nebo později.</p>"}, {"_id": "227813a", "tab_title": "Jak dlouho trvá vytvoření firemního webu?", "tab_content": "<p>Obvykle 2–6 týdnů podle rozsahu a podkladů.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "f624e9f", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "50ac57c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "affb61d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "c28da44", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "cc52062", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "fefa351", "elType": "widget", "widgetType": "heading", "settings": {"title": "Pojďme to probrat.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "be19d04", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Napište pár vět o svém podnikání nebo rovnou zavolejte. Ozvu se obvykle do jednoho pracovního dne.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "0060245", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-contact", "html_tag": "div"}, "elements": [{"id": "dc9465e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-person ww-rv", "html_tag": "div"}, "elements