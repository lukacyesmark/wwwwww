, {"id": "143d450", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Firemní web</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "335f41b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na rozsahu, funkcích a grafice. Nabídku vám připravíme zdarma a nezávazně.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "b4989fc", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "dcf3291", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "429321d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "6abcba1", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – firemní web", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "693907e", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "30daa35", "tab_title": "Kolik stránek by měl mít firemní web?", "tab_content": "<p>Většině firem stačí 5–15 stránek: úvod, služby, reference, o firmě a kontakt. Každá klíčová služba si zaslouží vlastní stránku.</p>"}, {"_id": "748c8e5", "tab_title": "Co když nemáme texty?", "tab_content": "<p>Pomůžeme s nimi. Stačí nám informace o firmě a službách, texty připravíme a doladíme s vámi.</p>"}, {"_id": "2b6c61f", "tab_title": "Potřebujeme profesionální fotky?", "tab_content": "<p>Vlastní fotky působí výrazně důvěryhodněji než fotobanka. Pokud je nemáte, doporučíme fotografa.</p>"}, {"_id": "5c5ca3d", "tab_title": "Můžeme mít web ve více jazycích?", "tab_content": "<p>Ano. Jazykové verze přidáme hned, nebo později.</p>"}, {"_id": "5904f0c", "tab_title": "Jak dlouho trvá vytvoření firemního webu?", "tab_content": "<p>Obvykle 2–6 týdnů podle rozsahu a podkladů.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "d1b34c4", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "c606103", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "f5529d8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "d9b8adb", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "47e2e0c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "723ce48", "elType": "widget", "widgetType": "heading", "settings": {"title": "Pojďme to probrat.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "ef3b7b6", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Napište pár vět o svém podnikání nebo rovnou zavolejte. Ozvu se obvykle do jednoho pracovního dne.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "6dbc22b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-contact", "html_tag": "div"}, "elements": [{"id": "75cd5fb", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-person ww-rv", "html_tag": "div"}, "elements