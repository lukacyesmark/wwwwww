tainer", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "3ae07f9", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "0665379", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "906c2d1", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – web pro psychologa a terapeuta", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "754ae3f", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "86611b6", "tab_title": "Jak zajistit diskrétnost na webu?", "tab_content": "<p>Formulář bez zbytečných údajů, zabezpečený přenos a jasné informace o ochraně dat. Nesdílíme nic s reklamními sítěmi bez souhlasu.</p>"}, {"_id": "b1ed3c3", "tab_title": "Má smysl nabízet na webu online terapii?", "tab_content": "<p>Ano – rozšíří to okruh klientů daleko za vaše město.</p>"}, {"_id": "f723352", "tab_title": "Jak dlouho trvá vytvoření webu – psychologická praxe?", "tab_content": "<p>Jednodušší web bývá hotový za 2–4 týdny, rozsáhlejší s rezervacemi nebo e-shopem za 4–8 týdnů. Přesný harmonogram dostanete v nabídce.</p>"}, {"_id": "97be192", "tab_title": "Budu si web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, ceník, fotky i nové stránky změníte sami a ukážeme vám, jak na to.</p>"}, {"_id": "422a70b", "tab_title": "Tvoříte weby jen v Jeseníku?", "tab_content": "<p>Sídlíme v Jeseníku, ale weby tvoříme pro klienty z celé České republiky. Spolupráce běží online, místní rádi potkáme osobně.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "0607c6d", "elType": "container", "isInner": false, "