"flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "2b720b3", "elType": "widget", "widgetType": "heading", "settings": {"title": "03", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "a941caf", "elType": "widget", "widgetType": "heading", "settings": {"title": "Struktura webu", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "48775f9", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Navrhneme, jaké stránky web potřebuje a jak po nich návštěvník dojde k poptávce.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "88bb05e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "817273f", "elType": "widget", "widgetType": "heading", "settings": {"title": "04", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "45c1bf5", "elType": "widget", "widgetType": "heading", "settings": {"title": "Obsah", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "52ba92f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pomůžeme s texty, které prodávají a zároveň dobře fungují ve vyhledávačích.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "8af6087", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "924b133", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "e70016f", "elType": "widget", "widgetType": "heading", "settings": {"title": "Design", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "96b4233", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Grafický návrh v duchu vaší značky. Připomínkujete, dokud nejste spokojení.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "5ba477b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "d647174", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "1fe9d55", "elType": "widget", "widgetType": "heading", "settings": {"title": "Realizace", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "752dc74", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Web postavíme na WordPressu s Elementorem, u individuálních projektů na October CMS.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "999c768", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "f2c3ab5", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "9d72e1a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Spuštění", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "4c3bd1d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Doména, hosting, SSL, Analytics, Search Console a kontrola všech formulářů.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "d09bf61", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "2421bcb", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "9f1da79", "elType": "widget", "widgetType": "heading", "settings": {"title": "Péče po spuštění", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "8e8deaf", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Aktualizace, zálohy, úpravy a další rozvoj webu podle výsledků.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "16aa382", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "3b7f35c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "631a8cc", "elType": "widget", "widgetType": "heading", "settings": {"title": "Proč tvorba webu na míru místo šablony", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "10d8f7b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Web z online stavebnice vypadá podobně jako tisíce dalších a často naráží na limity – v SEO, ve vlastnictví dat i v možnostech dalšího rozvoje. Tvorba webu na míru znamená, že strukturu, texty i design přizpůsobíme vašemu oboru a zákazníkům.</p><h3>Web, který si upravíte sami</h3><p>Stavíme převážně na WordPressu a Elementoru. Texty, fotky, ceník nebo novou stránku změníte sami bez programátora. Ukážeme vám, jak na to, a když budete chtít, úpravy převezmeme.</p><h3>SEO od prvního dne</h3><p>Každá stránka má promyšlené nadpisy, popisky, interní odkazy a strukturovaná data. Web tak má od začátku šanci ukázat se lidem, kteří hledají vaše služby na Googlu.</p><h3>Pro klienty z celé České republiky</h3><p>Sídlíme v Jeseníku, ale tvorba webových stránek u nás není vázaná na region. Pracujeme pro klienty z Olomouckého, Moravskoslezského i Pardu