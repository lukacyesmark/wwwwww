"flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "97a74de", "elType": "widget", "widgetType": "heading", "settings": {"title": "03", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "c6c4b77", "elType": "widget", "widgetType": "heading", "settings": {"title": "Struktura webu", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "791135d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Navrhneme, jaké stránky web potřebuje a jak po nich návštěvník dojde k poptávce.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "9f7c226", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "b3ed821", "elType": "widget", "widgetType": "heading", "settings": {"title": "04", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "6ebe43d", "elType": "widget", "widgetType": "heading", "settings": {"title": "Obsah", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "b81a61e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pomůžeme s texty, které prodávají a zároveň dobře fungují ve vyhledávačích.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "fb2222f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "d3c3a58", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "21d0c2a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Design", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "4e8c2d7", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Grafický návrh v duchu vaší značky. Připomínkujete, dokud nejste spokojení.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "e46c938", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "75780f6", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "4f9c6ce", "elType": "widget", "widgetType": "heading", "settings": {"title": "Realizace", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "68ba2fd", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Web postavíme na WordPressu s Elementorem, u individuálních projektů na October CMS.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "c2821cc", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "345ad1a", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "8843978", "elType": "widget", "widgetType": "heading", "settings": {"title": "Spuštění", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "9df921f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Doména, hosting, SSL, Analytics, Search Console a kontrola všech formulářů.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "2fbf907", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "6a81590", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "ae27d31", "elType": "widget", "widgetType": "heading", "settings": {"title": "Péče po spuštění", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "63199d6", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Aktualizace, zálohy, úpravy a další rozvoj webu podle výsledků.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "c304a1c", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "874bb42", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "e78cf46", "elType": "widget", "widgetType": "heading", "settings": {"title": "Proč tvorba webu na míru místo šablony", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "c04cfb4", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Web z online stavebnice vypadá podobně jako tisíce dalších a často naráží na limity – v SEO, ve vlastnictví dat i v možnostech dalšího rozvoje. Tvorba webu na míru znamená, že strukturu, texty i design přizpůsobíme vašemu oboru a zákazníkům.</p><h3>Web, který si upravíte sami</h3><p>Stavíme převážně na WordPressu a Elementoru. Texty, fotky, ceník nebo novou stránku změníte sami bez programátora. Ukážeme vám, jak na to, a když budete chtít, úpravy převezmeme.</p><h3>SEO od prvního dne</h3><p>Každá stránka má promyšlené nadpisy, popisky, interní odkazy a strukturovaná data. Web tak má od začátku šanci ukázat se lidem, kteří hledají vaše služby na Googlu.</p><h3>Pro klienty z celé České republiky</h3><p>Sídlíme v Jeseníku, ale tvorba webových stránek u nás není vázaná na region. Pracujeme pro klienty z Olomouckého, Moravskoslezského i Pardu