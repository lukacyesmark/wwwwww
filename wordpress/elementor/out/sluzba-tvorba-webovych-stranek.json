"_css_classes": "ww-rv"}, "elements": []}]}]}, {"id": "11fe0de", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "01a4926", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "57d75f2", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">Tvorba webu, která začíná u vašeho byznysu</a><a href=\"#prehled\">Postup</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "cf1072b", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "fee2b3a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "317877a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "e451944", "elType": "widget", "widgetType": "heading", "settings": {"title": "Hlavní služba", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "21897f4", "elType": "widget", "widgetType": "heading", "settings": {"title": "Tvorba webu, která začíná u vašeho byznysu", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "1a63661", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Dobrý web nezačíná výběrem barev, ale otázkou: co má návštěvník udělat? Zavolat, poslat poptávku, rezervovat termín, nebo nakoupit? Tvorba webových stránek u nás proto začíná krátkým rozhovorem o vašich zákaznících, službách a konkurenci. Teprve potom navrhujeme strukturu, texty a design.</p><p>Za wwwwww.cz stojí webové studio z Jeseníku a tým marketingové agentury Yesmark. Weby tvoříme pro řemeslníky, služby, ubytování, výrobní firmy i obce a spolky z celé České republiky. Spolupráce běží osobně nebo online – jak vám to vyhovuje.</p><p>Profesionální tvorba webových stránek pro nás znamená kompletní servis: návrh, texty, fotky, technické nastavení, základní SEO, napojení na Google Analytics a předání webu tak, abyste si ho uměli sami upravovat.</p>"}, "elements": []}]}, {"id": "db8b0ed", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "d8fe165", "elType": "widget", "widgetType": "heading", "settings": {"title": "Co dostanete", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "a9ae07d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Návrh struktury a designu na míru</li><li>Web pro mobil, tablet i počítač</li><li>Pomoc s texty a fotkami</li><li>Základní SEO a Google Firemní profil</li><li>Formuláře, mapy a napojení na e-mail</li><li>Cookies lištu a GDPR</li><li>Zaškolení do administrace</li><li>Podporu i po spuštění</li></ul>"}, "elements": []}, {"id": "9fa3037", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "170880c", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "ebb5f00", "elType": "container", "isIn