[]}, {"id": "d963eae", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na rozsahu, funkcích a grafice. Nabídku vám připravíme zdarma a nezávazně.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "b5c2278", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "6aba5ad", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "09b42b1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "cd384d3", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – tvorba webových stránek", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "0530cb6", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "1fc7687", "tab_title": "Kolik stojí tvorba webových stránek?", "tab_content": "<p>Tvorba webových stránek začíná na 9 900 Kč. Cena záleží na počtu stránek, funkcích a grafickém zpracování. Podrobnosti najdete na stránce <a href=\"/kolik-stoji-web/\">Kolik stojí web</a>.</p>"}, {"_id": "f45bb4f", "tab_title": "Jak dlouho trvá tvorba webu?", "tab_content": "<p>Jednodušší prezentační web bývá hotový za 2–4 týdny, rozsáhlejší web nebo e-shop za 4–8 týdnů. Přesný harmonogram dostanete v nabídce.</p>"}, {"_id": "c6f6c0d", "tab_title": "Co od vás budete potřebovat?", "tab_content": "<p>Hlavně informace o vašich službách, logo a ideálně vlastní fotky. S texty rádi pomůžeme.</p>"}, {"_id": "5e23240", "tab_title": "Na jakém systému web postavíte?", "tab_content": "<p>Nejčastěji na WordPressu s Elementorem, u individuálních projektů na October CMS. Web je vždy ve vašem vlastnictví.</p>"}, {"_id": "3bfee56", "tab_title": "Pomůžete s doménou a hostingem?", "tab_content": "<p>Ano. Doménu i hosting zařídíme, nebo web napojíme na ty, které už máte.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "aade61d", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "117f942", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "b0aeb9d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "3c17de9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "66b650c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "8a7a555", "elType": "widget", "widgetType": "heading", "settings": {"title": "Pojďme to probrat.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "4c998fc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Napište pár vět o svém podnikání nebo rovnou zavolejte. Ozvu se obvykle do jednoho pracovního dne.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "dc64946", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-contact", "html_tag": "div"}, "elements": [{"id": "bb385b3", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-person ww-rv", "html_tag": "div"}, "elements"