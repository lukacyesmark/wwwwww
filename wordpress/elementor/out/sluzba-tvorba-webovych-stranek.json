lumn", "css_classes": "ww-c ww-row ww-rv", "html_tag": "div"}, "elements": [{"id": "c6e6ff1", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci nezávaznou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}, {"id": "1837d91", "elType": "widget", "widgetType": "button", "settings": {"text": "Zavolat 731 842 606", "link": {"url": "tel:+420731842606", "is_external": "", "nofollow": ""}, "_css_classes": "ww-btn--ghost ww-btn--plain"}, "elements": []}]}, {"id": "5bc5317", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><span>✓ Weby od 9 900 Kč</span><span>✓ Nabídka zdarma</span><span>✓ Koncept agentury Yesmark</span></p>", "_css_classes": "ww-trust ww-rv"}, "elements": []}]}, {"id": "718dac2", "elType": "widget", "widgetType": "html", "settings": {"html": "<figure class=\"v-hv\"><img src=\"https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg\" alt=\"Tvorba webových stránek – ukázka webu KONRADT\" decoding=\"async\"><figcaption>Reference · KONRADT</figcaption></figure>", "_css_classes": "ww-rv"}, "elements": []}]}]}, {"id": "63a73dd", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "e58fec9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "a64fc59", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">Tvorba webu, která začíná u vašeho byznysu</a><a href=\"#prehled\">Postup</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "7b7a517", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "f04d610", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "989dc1d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "117a495", "elType": "widget", "widgetType": "heading", "settings": {"title": "Hlavní služba", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "24b7553", "elType": "widget", "widgetType": "heading", "settings": {"title": "Tvorba webu, která začíná u vašeho byznysu", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "63b1b90", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Dobrý web nezačíná výběrem barev, ale otázkou: co má návštěvník udělat? Zavolat, poslat poptávku, rezervovat termín, nebo nakoupit? Tvorba webových stránek u nás proto začíná krátkým rozhovorem o vašich zákaznících, službách a konkurenci. Teprve potom navrhujeme strukturu, texty a design.</p><p>Za wwwwww.cz stojí webové studio z Jeseníku a tým marketingové agentury Yesmark. Weby tvoříme pro řemeslníky, služby, ubytování, výrobní firmy i obce a spolky z celé České republiky. Spolupráce běží osobně nebo online – jak vám to vyhovuje.</p><p>Profesionální tvorba webových stránek pro nás znamená kompletní servis: návrh, texty, fotky, technické nastavení, základní SEO, napojení na Google Analytics a předání webu tak, abyste si ho uměli sami upravovat.</p>"}, "elements": []}]}, {"id": "8dcddc5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "4624e71", "elType": "widget", "widgetType": "heading", "settings": {"title": "Co dostanete", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "76927a3", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Návrh struktury a designu na míru</li><li>Web pro mobil, tablet i počítač</li><li>Pomoc s texty a fotkami</li><li>Základní SEO a Google Firemní profil</li><li>Formuláře, mapy a napojení na e-mail</li><li>Cookies lištu a GDPR</li><li>Zaškolení do administrace</li><li>Podporu i po spuštění</li></ul>"}, "elements": []}, {"id": "d0a0ee0", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "35438bd", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "4f0c176", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "556e241", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "7ddb060", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "0369876", "elType": "widget", "widgetType": "heading", "settings": {"title": "Postup", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "cfbe468", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jak probíhá tvorba webových stránek", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "10c1817", "elType": "widget", "w