_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "d4aa278", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "415fdfd", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "f137b25", "elType": "widget", "widgetType": "heading", "settings": {"title": "Údržba a péče", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "b1d47c3", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web potřebuje péči i po spuštění", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "5c8b6f3", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Web není hotový dnem spuštění. Systém a pluginy potřebují aktualizace, obsah zastarává a konkurence nespí. Bez pravidelné péče se z dobrého webu postupně stává problém.</p><p>Správa webu u nás znamená, že máte jednoho člověka, kterému napíšete, když potřebujete cokoli změnit. Úpravy, nové stránky, akce nebo změny ceníku – vyřešíme za vás.</p><p>Spravujeme weby, které jsme postavili, i weby od jiných dodavatelů. Na začátku web projdeme a navrhneme, co je potřeba opravit.</p>"}, "elements": []}]}, {"id": "d00e947", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "6016d18", "elType": "widget", "widgetType": "heading", "settings": {"title": "Správa webu zahrnuje", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "373e0c9", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Aktualizace WordPressu a pluginů</li><li>Pravidelné zálohy</li><li>Kontrola zabezpečení</li><li>Úpravy textů a fotek</li><li>Nové stránky a sekce</li><li>Kontrolu formulářů</li><li>Dohled nad Search Console</li><li>Konzultace k rozvoji webu</li></ul>"}, "elements": []}, {"id": "4fe6caa", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "947f685", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "e8c1fef", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "370e349", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "f2c05aa", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "273b64b", "elType": "widget", "widgetType": "heading", "settings": {"title": "Co hlídáme", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "8aa2b00", "elType": "widget", "widgetType": "heading", "settings": {"title": "Správa webu: 8 věcí, o které se postaráme", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "2cdee88", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pravidelná péče, díky které web funguje a nepřestane přivádět zákazníky.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "872e0e9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-grid4", "