e": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "27bece2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "8c02d04", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">Web potřebuje péči i po spuštění</a><a href=\"#prehled\">Co hlídáme</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "1661028", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "fc17f91", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "9efbf98", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "8cd60a1", "elType": "widget", "widgetType": "heading", "settings": {"title": "Údržba a péče", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "80a5a67", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web potřebuje péči i po spuštění", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "89b7308", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Web není hotový dnem spuštění. Systém a pluginy potřebují aktualizace, obsah zastarává a konkurence nespí. Bez pravidelné péče se z dobrého webu postupně stává problém.</p><p>Správa webu u nás znamená, že máte jednoho člověka, kterému napíšete, když potřebujete cokoli změnit. Úpravy, nové stránky, akce nebo změny ceníku – vyřešíme za vás.</p><p>Spravujeme weby, které jsme postavili, i weby od jiných dodavatelů. Na začátku web projdeme a navrhneme, co je potřeba opravit.</p>"}, "elements": []}]}, {"id": "4818176", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "ef7dd26", "elType": "widget", "widgetType": "heading", "settings": {"title": "Správa webu zahrnuje", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "66bd7dd", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Aktualizace WordPressu a pluginů</li><li>Pravidelné zálohy</li><li>Kontrola zabezpečení</li><li>Úpravy textů a fotek</li><li>Nové stránky a sekce</li><li>Kontrolu formulářů</li><li>Dohled nad Search Console</li><li>Konzultace k rozvoji webu</li></ul>"}, "elements": []}, {"id": "1bb6140", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "0b6c669", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "2c70a33", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "0cff132", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "df852c4", "elType": "container", "isInner": true, "settings": 