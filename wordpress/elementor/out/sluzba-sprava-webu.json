e": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "1961eae", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "d9a859e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">Web potřebuje péči i po spuštění</a><a href=\"#prehled\">Co hlídáme</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "cbabb01", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "51dae6b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "b2c382f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "242b402", "elType": "widget", "widgetType": "heading", "settings": {"title": "Údržba a péče", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "a03a80c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web potřebuje péči i po spuštění", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "632d73f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Web není hotový dnem spuštění. Systém a pluginy potřebují aktualizace, obsah zastarává a konkurence nespí. Bez pravidelné péče se z dobrého webu postupně stává problém.</p><p>Správa webu u nás znamená, že máte jednoho člověka, kterému napíšete, když potřebujete cokoli změnit. Úpravy, nové stránky, akce nebo změny ceníku – vyřešíme za vás.</p><p>Spravujeme weby, které jsme postavili, i weby od jiných dodavatelů. Na začátku web projdeme a navrhneme, co je potřeba opravit.</p>"}, "elements": []}]}, {"id": "07f052c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "ba3e861", "elType": "widget", "widgetType": "heading", "settings": {"title": "Správa webu zahrnuje", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "c484a39", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Aktualizace WordPressu a pluginů</li><li>Pravidelné zálohy</li><li>Kontrola zabezpečení</li><li>Úpravy textů a fotek</li><li>Nové stránky a sekce</li><li>Kontrolu formulářů</li><li>Dohled nad Search Console</li><li>Konzultace k rozvoji webu</li></ul>"}, "elements": []}, {"id": "6327b96", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "dbb7e06", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "adb18b2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "82b0ed5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "6bfc64c", "elType": "container", "isInner": true, "settings": 