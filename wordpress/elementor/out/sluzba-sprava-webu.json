etType": "button", "settings": {"text": "Všechny reference", "link": {"url": "https://yesmark.eu/reference/?utm_source=wwwwww.cz&utm_medium=referral&utm_campaign=wwwwww_reference&utm_content=homepage_all", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--dark ww-btn--ext"}, "elements": []}]}]}]}, {"id": "70dde36", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "cenik"}, "elements": [{"id": "986224d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "9a5c58b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "1d797e0", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "865ef33", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Správa webu</small>na míru", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "91bc7b1", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na rozsahu, funkcích a grafice. Nabídku vám připravíme zdarma a nezávazně.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "6c2a878", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "3a4781e", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "11ae0ad", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "738567e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – správa webu", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "1231b2a", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "60d7828", "tab_title": "Spravujete i weby, které jste nedělali?", "tab_content": "<p>Ano. Na začátku web projdeme, zazálohujeme a navrhneme, co je potřeba opravit.</p>"}, {"_id": "c545619", "tab_title": "Jak rychle reagujete na úpravy?", "tab_content": "<p>Běžné úpravy obvykle během několika pracovních dní. Termín vždy domluvíme předem.</p>"}, {"_id": "4e3b550", "tab_title": "Co když se web rozbije?", "tab_content": "<p>Díky pravidelným zálohám web obnovíme a zjistíme příčinu problému.</p>"}, {"_id": "124ee9d", "tab_title": "Mohu si některé úpravy dělat sám?", "tab_content": "<p>Samozřejmě. Správa webu nevylučuje, abyste si drobné změny dělali sami v administraci.</p>"}, {"_id": "942c913", "tab_title": "Řešíte i hosting a doménu?", "tab_content": "<p>Ano. Pomůžeme s prodloužením domény, hostingem i nastavením e-mailů.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "952b611", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "f98d2c6", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "fa8dc3a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "c12284b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_d