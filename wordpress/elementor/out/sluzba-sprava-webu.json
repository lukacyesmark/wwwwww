4b", "elType": "widget", "widgetType": "heading", "settings": {"title": "Zálohy", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "ed946ba", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pravidelné zálohy pro případ, že se něco pokazí.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "06a6711", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "1637315", "elType": "widget", "widgetType": "heading", "settings": {"title": "03", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "4c39298", "elType": "widget", "widgetType": "heading", "settings": {"title": "Zabezpečení", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "88d8627", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Kontrola přístupů, hesel a podezřelé aktivity.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "db81904", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "400f335", "elType": "widget", "widgetType": "heading", "settings": {"title": "04", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "901d3d3", "elType": "widget", "widgetType": "heading", "settings": {"title": "Obsah", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "65b9b4f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Úpravy textů, ceníků, fotek a akcí podle vašich požadavků.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "31b180c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "8c0112f", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "28f05f6", "elType": "widget", "widgetType": "heading", "settings": {"title": "Formuláře", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "06efa67", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Ověřujeme, že poptávky z webu skutečně dorazí.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "d3c3db2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "b4ea662", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "3e1b788", "elType": "widget", "widgetType": "heading", "settings": {"title": "SEO", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "0487035", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Sledujeme Search Console a opravujeme chyby indexace.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "979674b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "48e58b5", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "5cfc4e7", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cookies a GDPR", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "5ecc252", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Lišta a dokumenty v souladu s aktuálními pravidly.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "022a8ac", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "1cdb5e2", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "481fa7f", "elType": "widget", "widgetType": "heading", "settings": {"title": "Rozvoj", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "9ebae7e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Návrhy na vylepšení podle návštěvnosti a poptávek.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "051f67b", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "51fe588", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "0a54127", "elType": "widget", "widgetType": "heading", "settings": {"title": "Proč nesvěřit správu webu náhodě", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "e1a91f4", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Neaktualizovaný WordPress je častým cílem útoků. Nefunkční formulář znamená ztracené poptávky, o kterých nevíte. A zastaralý obsah odrazuje zákazníky. Pravidelná správa webu těmto problémům předchází.</p><h3>Propagace a kampaně</h3><p>Se správou webu umíme navázat i propagací: PPC kampaně, sociální sítě a <a href=\"/seo-optimalizace-webu/\">SEO optimalizace</a> zajišťuje tým agentury Yesmark.</p><h3>Převezmeme i cizí web</h3><p>Máte web od jiného dodavatele, který už nereaguje? Web projdeme, zazálohujeme a převezmeme. Pokud je zastaralý, navrhneme <a href=\"/redesign-webu/\">redesign webu</a>.</p><h3>Kolik stojí správa webu</h3><p>Cena správy webu závisí na velikosti webu a rozsahu úprav. Nabízíme pravidelnou měsíční správu i jednorázové zásahy podle potřeby.</p>", "_css_classes": "ww-legaltext"}, "elements": []}]}]}, {"id": "ba55d98", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "reference"}, "elements": [{"id": "eabb692", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "c13985d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "aaa18c0", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "ef4ce0b", "elType": "widget", "widgetType": "heading", "settings": {"title": "Reference", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "5221484", "elType": "widget", "widgetType": "heading", "settings": {"title": "Weby, na které jsme hrdí.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "f4dde3a", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Výběr realizací. Celé portfolio webů, e-shopů a kampaní najdete na Yesmark.eu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "1afef21", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-refs", "html_tag": "div"}, "elements": [{"id": "89691aa", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "db711f7", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "9f22e83", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 28, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg", "alt": "Reference: web Konradt", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "97bd882", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "f58def9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "e2db6c7", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · CNC obrábění", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "7e0c732", "elType": "widget", "widgetType": "heading", "settings": {"title": "Konradt", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "b957edc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro společnost KONRADT jsme vytvořili nové webové stránky zaměřené na profesionální prezentaci služeb v oblasti CNC obrábění, montáže a zpracování kovů. Při realizaci jsme kladli důraz na moderní technický vzhled, přehledné představení výrobních možností společnosti a srozumitelnou prezentaci jednotlivých služeb.</p><p>Součástí realizace byla také optimalizace struktury a obsahu webu s ohledem na vyhledávače a lepší dohledatelnost služeb v oblasti CNC frézování, CNC soustružení, montážních prací a dodávek odlitků.</p>"}, "elements": []}, {"id": "e9f44fa", "elType": "widget", "widgetType": "button", "settings": {"text": "konradt.cz", "link": {"url": "https://www.konradt.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "7251364", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "c7b7f12", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "f230b8a", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 29, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-monika-velickova-web.jpg", "alt": "Reference: web Monika Veličková", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "62560b9", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "d305990", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "6c02c97", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Reality Jeseníky", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "425a942", "elType": "widget", "widgetType": "heading", "settings": {"title": "Monika Veličková", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "026bf54", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro realitní makléřku Moniku Veličkovou jsme vytvořili nové webové stránky zaměřené na prezentaci nemovitostí a realitních služeb v Jeseníkách. Při realizaci jsme kladli důraz na moderní a osobitý design, přehlednou prezentaci nabízených nemovitostí a především na budování osobní značky, která staví na znalosti regionu, individuálním přístupu a zkušenostech s realitami i investicemi.</p>"}, "elements": []}, {"id": "dd0e89d", "elType": "widget", "widgetType": "button", "settings": {"text": "monikavelickova.cz", "link": {"url": "https://monikavelickova.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "2a39c98", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "bf30f86", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "b4ee0f5", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 27, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-brincil-web.jpg", "alt": "Reference: web Břinčil", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "5c0e64f", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "f05ca01", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "37e8cf1", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Technika a služby", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "7be6675", "elType": "widget", "widgetType": "heading", "settings": {"title": "Břinčil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "b8d06cd", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Při realizaci webu pro firmu Břinčil jsme kladli důraz na moderní a přehledný design, snadnou orientaci návštěvníků a kvalitní prezentaci společnosti i její techniky. Nový web zároveň slouží jako podpůrná prezentace hlavní společnosti Břinčil &amp; Míka s.r.o., pro kterou jsme v minulosti rovněž realizovali kompletní online prezentaci.</p>"}, "elements": []}, {"id": "fc8a08b", "elType": "widget", "widgetType": "button", "settings": {"text": "brincil.cz", "link": {"url": "https://brincil.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}]}, {"id": "21976b1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row ww-refs-more ww-rv", "html_tag": "div"}, "elements": [{"id": "2c000d2", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Další weby, e-shopy a kampaně najdete v portfoliu Yesmark.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "758891f", "elType": "widget", "widgetType": "button", "settings": {"text": "Všechny reference", "link": {"url": "https://yesmark.eu/reference/?utm_source=wwwwww.cz&utm_medium=referral&utm_campaign=wwwwww_reference&utm_content=homepage_all", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--dark ww-btn--ext"}, "elements": []}]}]}]}, {"id": "06155da", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "cenik"}, "elements": [{"id": "47636e8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "0c69ba7", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "3851ad9", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "639abe9", "elType": "widget", "