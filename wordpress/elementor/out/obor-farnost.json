"_id": "b6fabd6", "tab_title": "Budu si web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, ceník, fotky i nové stránky změníte sami a ukážeme vám, jak na to.</p>"}, {"_id": "6d0422f", "tab_title": "Tvoříte weby jen v Jeseníku?", "tab_content": "<p>Sídlíme v Jeseníku, ale weby tvoříme pro klienty z celé České republiky. Spolupráce běží online, místní rádi potkáme osobně.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "c5db71b", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "f4fbf07", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "20813ad", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "03bceeb", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "ab93239", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "c59efcd", "elType": "widget", "widgetType": "heading", "settings": {"title": "Chcete web pro farnost?", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "f9cd882", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Napište pár vět o svém podnikání nebo rovnou zavolejte. Ozvu se obvykle do jednoho pracovního dne.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "2ccf0e2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes