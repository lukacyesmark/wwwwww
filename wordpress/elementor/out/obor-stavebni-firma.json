er", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "5c90d7d", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "38f0fa4", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "9f86575", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – web pro stavební firmu", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "63ac365", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "2952001", "tab_title": "Proč potřebuje stavební firma web, když má práce dost?", "tab_content": "<p>Kvůli lepším zakázkám a náboru. Kvalitní web přivádí investory s vyšším rozpočtem a pomáhá najít řemeslníky.</p>"}, {"_id": "07dc43b", "tab_title": "Jak ukázat realizace?", "tab_content": "<p>Stránkou pro každou zakázku – fotky před, během a po, rozsah prací a lokalita. To je zároveň skvělé SEO.</p>"}, {"_id": "000638d", "tab_title": "Jak dlouho trvá vytvoření webu – stavební firma?", "tab_content": "<p>Jednodušší web bývá hotový za 2–4 týdny, rozsáhlejší s rezervacemi nebo e-shopem za 4–8 týdnů. Přesný harmonogram dostanete v nabídce.</p>"}, {"_id": "dee04a7", "tab_title": "Budu si web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, ceník, fotky i nové stránky změníte sami a ukážeme vám, jak na to.</p>"}, {"_id": "ecb2a71", "tab_title": "Tvoříte weby jen v Jeseníku?", "tab_content": "<p>Sídlíme v Jeseníku, ale weby tvoříme pro klienty z celé České republiky. Spolupráce běží online, místní rádi potkáme osobně.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "998dd93", "elType": "container", "isI