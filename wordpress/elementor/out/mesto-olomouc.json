pe": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro společnost KONRADT jsme vytvořili nové webové stránky zaměřené na profesionální prezentaci služeb v oblasti CNC obrábění, montáže a zpracování kovů. Při realizaci jsme kladli důraz na moderní technický vzhled, přehledné představení výrobních možností společnosti a srozumitelnou prezentaci jednotlivých služeb.</p><p>Součástí realizace byla také optimalizace struktury a obsahu webu s ohledem na vyhledávače a lepší dohledatelnost služeb v oblasti CNC frézování, CNC soustružení, montážních prací a dodávek odlitků.</p>"}, "elements": []}, {"id": "2015696", "elType": "widget", "widgetType": "button", "settings": {"text": "konradt.cz", "link": {"url": "https://www.konradt.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "648a630", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "9181d32", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "ab05456", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 29, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-monika-velickova-web.jpg", "alt": "Reference: web Monika Veličková", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "e832d4e", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "7b75662", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "1a9a717", "elType": "widget", "widgetType": "headi