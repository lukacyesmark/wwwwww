6ea9a", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Další weby, e-shopy a kampaně najdete v portfoliu Yesmark.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "7f808bd", "elType": "widget", "widgetType": "button", "settings": {"text": "Všechny reference", "link": {"url": "https://yesmark.eu/reference/?utm_source=wwwwww.cz&utm_medium=referral&utm_campaign=wwwwww_reference&utm_content=homepage_all", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--dark ww-btn--ext"}, "elements": []}]}]}]}, {"id": "cfefe39", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "cenik"}, "elements": [{"id": "e520db4", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "0331812", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "9a7f962", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "1ee3620", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Web pro oční optiku</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "d922acc", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na počtu stránek, funkcích (rezervace, e-shop, jazyky) a grafice. Nabídku vám připravíme zdarma.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "e763761", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": 