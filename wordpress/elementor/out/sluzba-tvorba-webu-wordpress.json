 "elements": []}]}]}, {"id": "ea2576f", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "90043bf", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "9e23f22", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">Proč stavíme na WordPressu</a><a href=\"#prehled\">Výhody</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "8bfd7e5", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "0e34b4f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "725de46", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "8e51cf7", "elType": "widget", "widgetType": "heading", "settings": {"title": "WordPress + Elementor", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "35980a1", "elType": "widget", "widgetType": "heading", "settings": {"title": "Proč stavíme na WordPressu", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "a8637ac", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>WordPress pohání velkou část webů na světě. Je ověřený, má obrovskou komunitu a je pro něj snadné najít pomoc. Pro vás to znamená jistotu, že web nezůstane závislý na jednom dodavateli.</p><p>Tvorba webu WordPress u nás jde ruku v ruce s Elementorem – vizuálním editorem, ve kterém upravujete stránky tak, jak je vidí návštěvník. Žádný kód, žádné složité formuláře.</p><p>Tvorba webových stránek s administrací ale není jen o systému. Rozhoduje, jak web nastavíme: přehledné bloky, jasné styly a minimum zbytečných pluginů, aby se web snadno udržoval.</p>"}, "elements": []}]}, {"id": "5cb40bf", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "c8af7a3", "elType": "widget", "widgetType": "heading", "settings": {"title": "Co umí váš WordPress web", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "07e8f43", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Vizuální úpravy v Elementoru</li><li>Nové stránky a články bez kódu</li><li>Formuláře s odesíláním na e-mail</li><li>SEO plugin Rank Math</li><li>Napojení na Google Site Kit</li><li>Cookies lištu a souhlas GDPR</li><li>Rozšíření o e-shop WooCommerce</li><li>Zálohy a aktualizace</li></ul>"}, "elements": []}, {"id": "08e2963", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "5f1e1fc", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "ddafe88", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "feec355", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direc