asses": "ww-musttext"}, "elements": []}]}, {"id": "8ad2820", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "18e4001", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "14f191a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Komunita", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "b42bd11", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Ke WordPressu najdete návody, pluginy i odborníky v celé ČR.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "3a168f3", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "1fc7dc5", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "3172630", "elType": "widget", "widgetType": "heading", "settings": {"title": "Elementor", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "19cd995", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Vizuální editor, ve kterém upravujete stránku přímo tak, jak vypadá.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "0f47e51", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "2ce0512", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "2854734", "elType": "widget", "widgetType": "heading", "settings": {"title": "Rozumná cena", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "4565be5", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Díky ověřenému základu platíte za design a obsah, ne za vývoj systému.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "115b0b2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "51c6388", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "56ead2b", "elType": "widget", "widgetType": "heading", "settings": {"title": "Bezpečnost", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "38b6c9e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pravidelné aktualizace a zálohy drží web v dobré kondici.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "caeb61d", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "d9c2cd6", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "134b01a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Kdy WordPress a kdy něco jiného", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "dd2e530", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro prezentační weby, weby služeb, ubytování, obce i menší e-shopy je WordPress výborná volba. U projektů s velmi specifickou logikou, napojením na interní systémy nebo náročnými požadavky na míru sáhneme po October CMS.</p><h3>Kolik stojí tvorba webu WordPress</h3><p>Tvorba webu WordPress začíná na 9 900 Kč. Cena roste s počtem stránek, funkcí a jazyků. Podrobný rozpis najdete na stránce <a href=\"/kolik-stoji-web/\">Kolik stojí web</a>.</p><h3>Máte starý WordPress web?</h3><p>Pokud máte starší WordPress, který se špatně upravuje nebo vypadá zastarale, nemusíte začínat od nuly. Často stačí <a href=\"/redesign-webu/\">redesign webu</a> s převodem obsahu.</p><h3>Zaškolení v ceně</h3><p>Po spuštění vám ukážeme, jak web upravovat. Dostanete i krátký návod, ke kterému se můžete kdykoli vrátit.</p>", "_css_classes": "ww-legaltext"}, "elements": []}]}]}, {"id": "74900f2", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "reference"}, "elements": [{"id": "39957b5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "d035022", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "7091545", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "e7cee99", "elType": "widget", "widgetType": "heading", "settings": {"title": "Reference", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "af9d6d3", "elType": "widget", "widgetType": "heading", "settings": {"title": "Weby, na které jsme hrdí.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "3e0326b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Výběr realizací. Celé portfolio webů, e-shopů a kampaní najdete na Yesmark.eu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "7a3ea51", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-refs", "html_tag": "div"}, "elements": [{"id": "08768a3", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "ae108ef", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "92d2916", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 28, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg", "alt": "Reference: web Konradt", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "164e1ff", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "e16010e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "68458d5", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · CNC obrábění", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "a966a73", "elType": "widget", "widgetType": "heading", "settings": {"title": "Konradt", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "f2ba374", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro společnost KONRADT jsme vytvořili nové webové stránky zaměřené na profesionální prezentaci služeb v oblasti CNC obrábění, montáže a zpracování kovů. Při realizaci jsme kladli důraz na moderní technický vzhled, přehledné představení výrobních možností společnosti a srozumitelnou prezentaci jednotlivých služeb.</p><p>Součástí realizace byla také optimalizace struktury a obsahu webu s ohledem na vyhledávače a lepší dohledatelnost služeb v oblasti CNC frézování, CNC soustružení, montážních prací a dodávek odlitků.</p>"}, "elements": []}, {"id": "e42b912", "elType": "widget", "widgetType": "button", "settings": {"text": "konradt.cz", "link": {"url": "https://www.konradt.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "5db86f2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "6463be9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "948bce0", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 29, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-monika-velickova-web.jpg", "alt": "Reference: web Monika Veličková", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "b2917ae", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "758567b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "9bca644", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Reality Jeseníky", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "ddd8f61", "elType": "widget", "widgetType": "heading", "settings": {"title": "Monika Veličková", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "e857d06", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro realitní makléřku Moniku Veličkovou jsme vytvořili nové webové stránky zaměřené na prezentaci nemovitostí a realitních služeb v Jeseníkách. Při realizaci jsme kladli důraz na moderní a osobitý design, přehlednou prezentaci nabízených nemovitostí a především na budování osobní značky, která staví na znalosti regionu, individuálním přístupu a zkušenostech s realitami i investicemi.</p>"}, "elements": []}, {"id": "a8e5c1d", "elType": "widget", "widgetType": "button", "settings": {"text": "monikavelickova.cz", "link": {"url": "https://monikavelickova.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "7619dd5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "92c2d37", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "6f5f791", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 27, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-brincil-web.jpg", "alt": "Reference: web Břinčil", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "42526e6", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "dd15fcf", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "f8cc1bd", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Technika a služby", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "a16d482", "elType": "widget", "widgetType": "heading", "settings": {"title": "Břinčil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "461d487", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Při realizaci webu pro firmu Břinčil jsme kladli důraz na moderní a přehledný design, snadnou orientaci návštěvníků a kvalitní prezentaci společnosti i její techniky. Nový web zároveň slouží jako podpůrná prezentace hlavní společnosti Břinčil &amp; Míka s.r.o., pro kterou jsme v minulosti rovněž realizovali kompletní online prezentaci.</p>"}, "elements": []}, {"id": "5dfb2ec", "elType": "widget", "widgetType": "button", "settings": {"text": "brincil.cz", "link": {"url": "https://brincil.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}]}, {"id": "20d6d95", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row ww-refs-more ww-rv", "html_tag": "div"}, "elements": [{"id": "caf66a4", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Další weby, e-shopy a kampaně najdete v portfoliu Yesmark.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "6155c2f", "elType": "widget", "widgetType": "button", "settings": {"text": "Všechny reference", "link": {"url": "https://yesmark.eu/reference/?utm_source=wwwwww.cz&utm_medium=referral&utm_campaign=wwwwww_reference&utm_content=homepage_all", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--dark ww-btn--ext"}, "elements": []}]}]}]}, {"id": "0fc51e7", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "cenik"}, "elements": [{"id": "9a9b7ec", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "33aede7", "elType": "container", "isInner": true, "settings"