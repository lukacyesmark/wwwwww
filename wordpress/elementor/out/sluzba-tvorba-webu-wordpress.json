": "yes", "tabs": [{"_id": "4e41b1f", "tab_title": "Je WordPress zdarma?", "tab_content": "<p>Samotný WordPress je open-source a zdarma. Platíte za doménu, hosting, případné prémiové pluginy a hlavně za návrh a realizaci webu.</p>"}, {"_id": "ea45b53", "tab_title": "Zvládnu úpravy webu sám?", "tab_content": "<p>Ano. Díky Elementoru změníte texty, fotky i celé sekce sami. Zaškolení je součástí předání webu.</p>"}, {"_id": "1651c96", "tab_title": "Je WordPress bezpečný?", "tab_content": "<p>Při pravidelných aktualizacích, zálohách a rozumném výběru pluginů ano. O údržbu se můžeme postarat v rámci správy webu.</p>"}, {"_id": "3a9bf7c", "tab_title": "Můžete převzít můj stávající WordPress?", "tab_content": "<p>Ano. Projdeme ho, navrhneme úpravy a případně se postaráme o jeho další správu.</p>"}, {"_id": "3fe36fa", "tab_title": "Dá se na WordPressu postavit e-shop?", "tab_content": "<p>Ano, pomocí WooCommerce. Pro menší a střední e-shopy je to osvědčené řešení.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "9a6bee8", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "314f494", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "96536a0", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "e6125a7", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "0e906a1", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "7