": "yes", "tabs": [{"_id": "d28c97b", "tab_title": "Je WordPress zdarma?", "tab_content": "<p>Samotný WordPress je open-source a zdarma. Platíte za doménu, hosting, případné prémiové pluginy a hlavně za návrh a realizaci webu.</p>"}, {"_id": "a39655b", "tab_title": "Zvládnu úpravy webu sám?", "tab_content": "<p>Ano. Díky Elementoru změníte texty, fotky i celé sekce sami. Zaškolení je součástí předání webu.</p>"}, {"_id": "434aaaa", "tab_title": "Je WordPress bezpečný?", "tab_content": "<p>Při pravidelných aktualizacích, zálohách a rozumném výběru pluginů ano. O údržbu se můžeme postarat v rámci správy webu.</p>"}, {"_id": "ba8b416", "tab_title": "Můžete převzít můj stávající WordPress?", "tab_content": "<p>Ano. Projdeme ho, navrhneme úpravy a případně se postaráme o jeho další správu.</p>"}, {"_id": "c5fa43d", "tab_title": "Dá se na WordPressu postavit e-shop?", "tab_content": "<p>Ano, pomocí WooCommerce. Pro menší a střední e-shopy je to osvědčené řešení.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "840b7aa", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "4d1dc59", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "1558d6b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "533d4ea", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "8dcce7b", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "0