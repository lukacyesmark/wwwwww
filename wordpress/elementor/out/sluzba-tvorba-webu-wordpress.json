 "elements": []}]}]}, {"id": "57e5af6", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "2c6d4da", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "821ebbe", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">Proč stavíme na WordPressu</a><a href=\"#prehled\">Výhody</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "2abae7e", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "79f19d8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "fcb0bb1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "fe94007", "elType": "widget", "widgetType": "heading", "settings": {"title": "WordPress + Elementor", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "95b14e3", "elType": "widget", "widgetType": "heading", "settings": {"title": "Proč stavíme na WordPressu", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "f4338c3", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>WordPress pohání velkou část webů na světě. Je ověřený, má obrovskou komunitu a je pro něj snadné najít pomoc. Pro vás to znamená jistotu, že web nezůstane závislý na jednom dodavateli.</p><p>Tvorba webu WordPress u nás jde ruku v ruce s Elementorem – vizuálním editorem, ve kterém upravujete stránky tak, jak je vidí návštěvník. Žádný kód, žádné složité formuláře.</p><p>Tvorba webových stránek s administrací ale není jen o systému. Rozhoduje, jak web nastavíme: přehledné bloky, jasné styly a minimum zbytečných pluginů, aby se web snadno udržoval.</p>"}, "elements": []}]}, {"id": "6662448", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "30772a1", "elType": "widget", "widgetType": "heading", "settings": {"title": "Co umí váš WordPress web", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "8270d83", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Vizuální úpravy v Elementoru</li><li>Nové stránky a články bez kódu</li><li>Formuláře s odesíláním na e-mail</li><li>SEO plugin Rank Math</li><li>Napojení na Google Site Kit</li><li>Cookies lištu a souhlas GDPR</li><li>Rozšíření o e-shop WooCommerce</li><li>Zálohy a aktualizace</li></ul>"}, "elements": []}, {"id": "b13fe62", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "811d82d", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "9f3e971", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "c8afc17", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direc