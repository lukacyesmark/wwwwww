"}, {"_id": "c50deeb", "tab_title": "Je WordPress bezpečný?", "tab_content": "<p>Při pravidelných aktualizacích, zálohách a rozumném výběru pluginů ano. O údržbu se můžeme postarat v rámci správy webu.</p>"}, {"_id": "3a6fbcb", "tab_title": "Můžete převzít můj stávající WordPress?", "tab_content": "<p>Ano. Projdeme ho, navrhneme úpravy a případně se postaráme o jeho další správu.</p>"}, {"_id": "157ce84", "tab_title": "Dá se na WordPressu postavit e-shop?", "tab_content": "<p>Ano, pomocí WooCommerce. Pro menší a střední e-shopy je to osvědčené řešení.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "37aeb8e", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "7e80300", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "4b9f09a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "b12175a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "3a20e38", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "d52efa2", "elType": "widget", "widgetType": "heading", "settings": {"title": "Pojďme to probrat.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "c00b30a", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Napište pár vět o svém podnikání nebo rovnou zavolejte. Ozvu se obvykle do jednoho pracovního dne.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": [