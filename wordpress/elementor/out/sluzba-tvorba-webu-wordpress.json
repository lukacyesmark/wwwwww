"}, {"_id": "2ae3d58", "tab_title": "Je WordPress bezpečný?", "tab_content": "<p>Při pravidelných aktualizacích, zálohách a rozumném výběru pluginů ano. O údržbu se můžeme postarat v rámci správy webu.</p>"}, {"_id": "ccc1895", "tab_title": "Můžete převzít můj stávající WordPress?", "tab_content": "<p>Ano. Projdeme ho, navrhneme úpravy a případně se postaráme o jeho další správu.</p>"}, {"_id": "33463d3", "tab_title": "Dá se na WordPressu postavit e-shop?", "tab_content": "<p>Ano, pomocí WooCommerce. Pro menší a střední e-shopy je to osvědčené řešení.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "fc3d9f7", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "1d6fe9e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "00f01d0", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "f10ef38", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "50cfd54", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "d7ab952", "elType": "widget", "widgetType": "heading", "settings": {"title": "Pojďme to probrat.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "5323986", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Napište pár vět o svém podnikání nebo rovnou zavolejte. Ozvu se obvykle do jednoho pracovního dne.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": [