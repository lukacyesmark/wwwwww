 "elements": []}]}]}, {"id": "c1e8a9e", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "ddb4253", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "a81ec59", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">Proč stavíme na WordPressu</a><a href=\"#prehled\">Výhody</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "502412d", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "7496819", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "9b276cc", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "a3967fc", "elType": "widget", "widgetType": "heading", "settings": {"title": "WordPress + Elementor", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "0536039", "elType": "widget", "widgetType": "heading", "settings": {"title": "Proč stavíme na WordPressu", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "70ede84", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>WordPress pohání velkou část webů na světě. Je ověřený, má obrovskou komunitu a je pro něj snadné najít pomoc. Pro vás to znamená jistotu, že web nezůstane závislý na jednom dodavateli.</p><p>Tvorba webu WordPress u nás jde ruku v ruce s Elementorem – vizuálním editorem, ve kterém upravujete stránky tak, jak je vidí návštěvník. Žádný kód, žádné složité formuláře.</p><p>Tvorba webových stránek s administrací ale není jen o systému. Rozhoduje, jak web nastavíme: přehledné bloky, jasné styly a minimum zbytečných pluginů, aby se web snadno udržoval.</p>"}, "elements": []}]}, {"id": "91295d4", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "16dae4c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Co umí váš WordPress web", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "7ae9945", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Vizuální úpravy v Elementoru</li><li>Nové stránky a články bez kódu</li><li>Formuláře s odesíláním na e-mail</li><li>SEO plugin Rank Math</li><li>Napojení na Google Site Kit</li><li>Cookies lištu a souhlas GDPR</li><li>Rozšíření o e-shop WooCommerce</li><li>Zálohy a aktualizace</li></ul>"}, "elements": []}, {"id": "42389db", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "e8cef61", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "e0f098d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "dd02689", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direc