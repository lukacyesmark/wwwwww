: {"editor": "<p>Při realizaci webu pro firmu Břinčil jsme kladli důraz na moderní a přehledný design, snadnou orientaci návštěvníků a kvalitní prezentaci společnosti i její techniky. Nový web zároveň slouží jako podpůrná prezentace hlavní společnosti Břinčil &amp; Míka s.r.o., pro kterou jsme v minulosti rovněž realizovali kompletní online prezentaci.</p>"}, "elements": []}, {"id": "ee90aec", "elType": "widget", "widgetType": "button", "settings": {"text": "brincil.cz", "link": {"url": "https://brincil.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}]}, {"id": "29e8937", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row ww-refs-more ww-rv", "html_tag": "div"}, "elements": [{"id": "ad7e48e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Další weby, e-shopy a kampaně najdete v portfoliu Yesmark.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "2882bf3", "elType": "widget", "widgetType": "button", "settings": {"text": "Všechny reference", "link": {"url": "https://yesmark.eu/reference/?utm_source=wwwwww.cz&utm_medium=referral&utm_campaign=wwwwww_reference&utm_content=homepage_all", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--dark ww-btn--ext"}, "elements": []}]}]}]}, {"id": "af25b4e", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "cenik"}, "elements": [{"id": "81dd4da", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "427b6eb", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "