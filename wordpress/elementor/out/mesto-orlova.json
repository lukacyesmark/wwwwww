, "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "8fe597f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "d999aa5", "elType": "widget", "widgetType": "heading", "settings": {"title": "Ceník · Orlová", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "cd32d86", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Tvorba webových stránek Orlová</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "2c548eb", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná částka se odvíjí od rozsahu, funkcí a grafického zpracování. Každý projekt naceňujeme individuálně a férově.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "93cec04", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "b567f9c", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "b9885f7", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "ccf9c20", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – tvorba webových stránek Orlová", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "94235f6", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "27be313", "tab_title": "Kolik stojí tvorba webových stránek v Orlové?", "tab_content": "<p>Tvorba webových stránek Orlová začíná na 9 900 Kč. Konečná cena záleží na rozsahu, funkcích a grafickém zpracování. Po krátké konzultaci dostanete nezávaznou nabídku zdarma.</p>"}, {"_id": "53c0ac9", "tab_title": "Musím za vámi jezdit do Jeseníku?", "tab_content": "<p>Nemusíte. Konzultace, návrhy i předání webu zvládneme online – telefonem, videohovorem a e-mailem. Když je to potřeba, rádi se potkáme i osobně.</p>"}, {"_id": "87ba8a5", "tab_title": "Pomůžete, aby nás našli zákazníci z Orlové?", "tab_content": "<p>Ano. Web postavíme s ohledem na lokální SEO pro Orlová – obsah zaměřený na vaše služby a lokalitu, Google Firemní profil a technické SEO od prvního dne.</p>"}, {"_id": "ede93b2", "tab_title": "Má smysl web pro malou firmu z Orlové?", "tab_content": "<p>Ano. Většina zákazníků dnes hledá služby na Googlu. I jednoduchý, dobře postavený web s Google Firemním profilem přinese poptávky, které by jinak skončily u konkurence.</p>"}, {"_id": "4c6c003", "tab_title": "Budu si moci web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, fotky i nové stránky si upravíte sami a ukážeme vám, jak na to.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "c311cf0", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "9f34cbb", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "0ed0c07", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "81e6d09", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "3dfa004", "elType": "widget", "widgetType": "heading", "settings"