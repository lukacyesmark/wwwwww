container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "41c7933", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "0029232", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "74632ec", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – web pro veterinární ordinaci", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "727e43b", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "69a3cd4", "tab_title": "Jak zvýraznit pohotovost?", "tab_content": "<p>Výraznou lištou nebo tlačítkem s telefonem v hlavičce na všech stránkách – na mobilu na jeden klik.</p>"}, {"_id": "360bc4a", "tab_title": "Mají veterinární ordinace na webu ceník?", "tab_content": "<p>Základní úkony (očkování, čipování, kastrace) ano – majitelé to ocení a ušetříte čas.</p>"}, {"_id": "4a5e323", "tab_title": "Jak dlouho trvá vytvoření webu – veterina?", "tab_content": "<p>Jednodušší web bývá hotový za 2–4 týdny, rozsáhlejší s rezervacemi nebo e-shopem za 4–8 týdnů. Přesný harmonogram dostanete v nabídce.</p>"}, {"_id": "d4a10a6", "tab_title": "Budu si web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, ceník, fotky i nové stránky změníte sami a ukážeme vám, jak na to.</p>"}, {"_id": "e5ef613", "tab_title": "Tvoříte weby jen v Jeseníku?", "tab_content": "<p>Sídlíme v Jeseníku, ale weby tvoříme pro klienty z celé České republiky. Spolupráce běží online, místní rádi potkáme osobně.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "a4920e7", "elType": "container", "isInner": false, "settings": {"con