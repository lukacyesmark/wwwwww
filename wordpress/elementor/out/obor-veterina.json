 ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "5485e57", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "8bf7e36", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "896f84b", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Web pro veterinární ordinaci</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "0d67547", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na počtu stránek, funkcích (rezervace, e-shop, jazyky) a grafice. Nabídku vám připravíme zdarma.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "8cb73f2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "3b8a8d3", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "1c79b1d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "b4dd8e9", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – web pro veterinární ordinaci", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "77b2c20", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "e969dcb", "tab_title": "Jak zvýraznit pohotovost?", "tab_content": "<p>Výraznou lištou nebo tlačítkem s telefonem v hlavičce na všech stránkách – na mobilu na jeden klik.</p>"}, {"_id": "132659e", "tab_title": "Mají veterinární ordinace na webu ceník?", "tab_content": "<p>Základní úkony (očkování, čipování, kastrace) ano – majitelé to ocení a ušetříte čas.</p>"}, {"_id": "f28610c", "tab_title": "Jak dlouho trvá vytvoření webu – veterina?", "tab_content": "<p>Jednodušší web bývá hotový za 2–4 týdny, rozsáhlejší s rezervacemi nebo e-shopem za 4–8 týdnů. Přesný harmonogram dostanete v nabídce.</p>"}, {"_id": "ec8f17c", "tab_title": "Budu si web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, ceník, fotky i nové stránky změníte sami a ukážeme vám, jak na to.</p>"}, {"_id": "a073672", "tab_title": "Tvoříte weby jen v Jeseníku?", "tab_content": "<p>Sídlíme v Jeseníku, ale weby tvoříme pro klienty z celé České republiky. Spolupráce běží online, místní rádi potkáme osobně.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "59f0e55", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "8f21f5f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "9292135", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "5d938dc", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "a9e9798", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "32de6dd", "elType": "widget", "widgetType": "heading", "settings": {"title": "Chcete web pro veterinární ordinaci?", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, 