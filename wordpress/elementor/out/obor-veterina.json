 ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "8a2995b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "0e02748", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "d7aff62", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Web pro veterinární ordinaci</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "e82f805", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na počtu stránek, funkcích (rezervace, e-shop, jazyky) a grafice. Nabídku vám připravíme zdarma.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "5a0971d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "33bcaa7", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "d766b27", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "87d5d17", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – web pro veterinární ordinaci", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "881360b", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "e02077e", "tab_title": "Jak zvýraznit pohotovost?", "tab_content": "<p>Výraznou lištou nebo tlačítkem s telefonem v hlavičce na všech stránkách – na mobilu na jeden klik.</p>"}, {"_id": "daf69c2", "tab_title": "Mají veterinární ordinace na webu ceník?", "tab_content": "<p>Základní úkony (očkování, čipování, kastrace) ano – majitelé to ocení a ušetříte čas.</p>"}, {"_id": "244026d", "tab_title": "Jak dlouho trvá vytvoření webu – veterina?", "tab_content": "<p>Jednodušší web bývá hotový za 2–4 týdny, rozsáhlejší s rezervacemi nebo e-shopem za 4–8 týdnů. Přesný harmonogram dostanete v nabídce.</p>"}, {"_id": "e1cb8a6", "tab_title": "Budu si web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, ceník, fotky i nové stránky změníte sami a ukážeme vám, jak na to.</p>"}, {"_id": "59a5386", "tab_title": "Tvoříte weby jen v Jeseníku?", "tab_content": "<p>Sídlíme v Jeseníku, ale weby tvoříme pro klienty z celé České republiky. Spolupráce běží online, místní rádi potkáme osobně.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "05e201f", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "dfe2752", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "89dad14", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "2382786", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "4db7ecd", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "e134037", "elType": "widget", "widgetType": "heading", "settings": {"title": "Chcete web pro veterinární ordinaci?", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, 