 "elements": []}, {"id": "cf158f1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "811d1ad", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "6228b10", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "e52801e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – web pro svatebního fotografa", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "6fb7c46", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "7dcc117", "tab_title": "Jak ukázat stovky fotek a nezpomalit web?", "tab_content": "<p>Moderní formáty (WebP), postupné načítání a správné velikosti – web zůstane rychlý i s velkým portfoliem.</p>"}, {"_id": "379c153", "tab_title": "Má smysl psát blog o svatbách?", "tab_content": "<p>Ano – každá svatba je příběh s místem a jmény, které lidé hledají. Je to nejlepší SEO pro svatební fotografy.</p>"}, {"_id": "bf94b2e", "tab_title": "Jak dlouho trvá vytvoření webu – svatební fotograf?", "tab_content": "<p>Jednodušší web bývá hotový za 2–4 týdny, rozsáhlejší s rezervacemi nebo e-shopem za 4–8 týdnů. Přesný harmonogram dostanete v nabídce.</p>"}, {"_id": "70a4aa6", "tab_title": "Budu si web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, ceník, fotky i nové stránky změníte sami a ukážeme vám, jak na to.</p>"}, {"_id": "108c86e", "tab_title": "Tvoříte weby jen v Jeseníku?", "tab_content": "<p>Sídlíme v Jeseníku, ale weby tvoříme pro klienty z celé České republiky. Spolupráce běží online, místní rádi potkáme osobně.</p>"}], "_css_classes": "ww-faq"}, "elemen