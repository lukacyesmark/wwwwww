content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "f70cf4d", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "6221259", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Web pro květinářství</small>od 9 900 Kč", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "f2a1b4e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na počtu stránek, funkcích (rezervace, e-shop, jazyky) a grafice. Nabídku vám připravíme zdarma.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "b1c5141", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "313efcd", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "d393757", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "337e08e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – web pro květinářství", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "0fdc52b", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "2f731d2", "tab_title": "Vyplatí se malému květinářství e-shop?", "tab_content": "<p>Ano, i s pár desítkami kytic. Lidé chtějí objednat a zaplatit online – hlavně když posílají květiny někomu jinému.</p>"}, {"_id": "c28f74f", "tab_title": "Jak řešit doručení?", "tab_content": "<p>Výběrem data a času doručení, zónami rozvozu a příplatky – vše přehledně v objednávce.</p>"}, {"_id": "53c426a", "tab_title": "Jak dlouho trvá vytvoření webu – květinářství?", "tab_content": "<p>Jednodušší web bývá hotový za 2–4 týdny, rozsáhlejší s rezervacemi nebo e-shopem za 4–8 týdnů. Přesný harmonogram dostanete v nabídce.</p>"}, {"_id": "7a67290", "tab_title": "Budu si web upravovat sám?", "tab_content": "<p>Ano. Stavíme na WordPressu a Elementoru – texty, ceník, fotky i nové stránky změníte sami a ukážeme vám, jak na to.</p>"}, {"_id": "de287b0", "tab_title": "Tvoříte weby jen v Jeseníku?", "tab_content": "<p>Sídlíme v Jeseníku, ale weby tvoříme pro klienty z celé České republiky. Spolupráce běží online, místní rádi potkáme osobně.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "dad43c5", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "4ca348c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "c73ad55", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "46cba5b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "39afe20", "elType": "widget", "widgetType": "heading", "settings": {"title": "Poptávka", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "0b55877", "elType": "widget", "widgetType": "heading", "settings": {"title": "Chcete web pro květinářství?", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "9f8e755", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Napište pár vět o svém podnikání nebo rovno