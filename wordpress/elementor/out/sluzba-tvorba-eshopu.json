ader_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "35ecb4c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Kontakty, recenze, obchodní podmínky a jasné informace o vrácení.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "926a422", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "4cac2f4", "elType": "widget", "widgetType": "heading", "settings": {"title": "04", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "0e09fd6", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jednoduchá objednávka", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "1bae7c0", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Co nejméně kroků a polí, nákup i bez registrace.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "c9f397d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "8770544", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "ebdeef3", "elType": "widget", "widgetType": "heading", "settings": {"title": "Platby a doprava", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "acf570d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Oblíbené platební metody a výdejní místa.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "66eab2a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "5a53d68", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "11da957", "elType": "widget", "widgetType": "heading", "settings": {"title": "Mobil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "a6fe74f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Většina zákazníků nakupuje z telefonu – e-shop musí fungovat na mobilu.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "ea87335", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "2f5ea5e", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "aa488d7", "elType": "widget", "widgetType": "heading", "settings": {"title": "SEO", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "71ca034", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Unikátní texty kategorií a produktů, které Google dokáže najít.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "d225363", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "38c6e4b", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "685140f", "elType": "widget", "widgetType": "heading", "settings": {"title": "Měření", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "88fb142", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Víte, odkud zákazníci přicházejí a co nakupují.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "c8e64d0", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "66e2c90", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "44994ae", "elType": "widget", "widgetType": "heading", "settings": {"title": "WooCommerce, nebo PrestaShop?", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "aa5a5bb", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>WooCommerce je ideální pro menší a střední e-shopy, které chtějí spojit obchod s obsahovým webem a jednoduchou administrací. PrestaShop se hodí pro obchody s větším katalogem a specifickými požadavky.</p><h3>Kolik stojí tvorba e-shopu</h3><p>Cenu ovlivňuje počet produktů, import dat, platby, doprava a napojení na účetnictví nebo sklad. Tvorbu e-shopu naceňujeme individuálně a nabídku připravíme zdarma.</p><h3>Máte už prezentační web?</h3><p>Pokud máte web na WordPressu, můžeme e-shop přidat přímo do něj. Pokud je web zastaralý, zvažte <a href=\"/redesign-webu/\">redesign webu</a> spolu se spuštěním obchodu.</p><h3>Propagace po spuštění</h3><p>E-shop potřebuje návštěvnost. S agenturou Yesmark navážeme PPC kampaněmi, sociálními sítěmi a <a href=\"/seo-optimalizace-webu/\">SEO optimalizací</a>.</p>", "_css_classes": "ww-legaltext"}, "elements": []}]}]}, {"id": "db59e3e", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "reference"}, "elements": [{"id": "9cb72f8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "8cf2da9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "ea204d5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "35988d2", "elType": "widget", "widgetType": "heading", "settings": {"title": "Reference", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "5c52be5", "elType": "widget", "widgetType": "heading", "settings": {"title": "Weby, na které jsme hrdí.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "2c27046", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Výběr realizací. Celé portfolio webů, e-shopů a kampaní najdete na Yesmark.eu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "d0adc47", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-refs", "html_tag": "div"}, "elements": [{"id": "2fb397c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "4dbd1ef", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "042978f", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 28, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg", "alt": "Reference: web Konradt", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "1314c96", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "3406303", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "502062d", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · CNC obrábění", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "b11ef71", "elType": "widget", "widgetType": "heading", "settings": {"title": "Konradt", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "36aa3be", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro společnost KONRADT jsme vytvořili nové webové stránky zaměřené na profesionální prezentaci služeb v oblasti CNC obrábění, montáže a zpracování kovů. Při realizaci jsme kladli důraz na moderní technický vzhled, přehledné představení výrobních možností společnosti a srozumitelnou prezentaci jednotlivých služeb.</p><p>Součástí realizace byla také optimalizace struktury a obsahu webu s ohledem na vyhledávače a lepší dohledatelnost služeb v oblasti CNC frézování, CNC soustružení, montážních prací a dodávek odlitků.</p>"}, "elements": []}, {"id": "b734db1", "elType": "widget", "widgetType": "button", "settings": {"text": "konradt.cz", "link": {"url": "https://www.konradt.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "0ff94a5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "28c5a6f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "30a3e0b", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 29, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-monika-velickova-web.jpg", "alt": "Reference: web Monika Veličková", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "b83fbb4", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "cef0849", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "491a366", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Reality Jeseníky", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "d09c8d1", "elType": "widget", "widgetType": "heading", "settings": {"title": "Monika Veličková", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "8cb4b08", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro realitní makléřku Moniku Veličkovou jsme vytvořili nové webové stránky zaměřené na prezentaci nemovitostí a realitních služeb v Jeseníkách. Při realizaci jsme kladli důraz na moderní a osobitý design, přehlednou prezentaci nabízených nemovitostí a především na budování osobní značky, která staví na znalosti regionu, individuálním přístupu a zkušenostech s realitami i investicemi.</p>"}, "elements": []}, {"id": "ac7d812", "elType": "widget", "widgetType": "button", "settings": {"text": "monikavelickova.cz", "link": {"url": "https://monikavelickova.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "5ee4937", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "961993a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "8121952", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 27, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-brincil-web.jpg", "alt": "Reference: web Břinčil", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "27ac0ae", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "a364c92", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "78a4dfd", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Technika a služby", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "7470be8", "elType": "widget", "widgetType": "heading", "settings": {"title": "Břinčil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "791cc6e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Při realizaci webu pro firmu Břinčil jsme kladli důraz na moderní a přehledný design, snadnou orientaci návštěvníků a kvalitní prezentaci společnosti i její techniky. Nový web zároveň slouží jako podpůrná prezentace hlavní společnosti Břinčil &amp; Míka s.r.o., pro kterou jsme v minulosti rovněž realizovali kompletní online prezentaci.</p>"}, "elements": []}, {"id": "a9fb4f2", "elType": "widget", "widgetType": "button", "settings": {"text": "brincil.cz", "link": {"url": "https://brincil.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}]}, {"id": "82cb923", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row ww-refs-more ww-rv", "html_tag": "div"}, "elements": [{"id": "d5d0d83", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Další weby, e-shopy a kampaně najdete v portfoliu Yesmark.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "5d17800", "elType": "widget", "widgetType": "button", "settings": {"text": "Všechny reference", "link": {"url": "https://yesmark.eu/reference/?utm_source=wwwwww.cz&utm_medium=referral&utm_campaign=wwwwww_reference&utm_content=homepage_all", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--dark ww-btn--ext"}, "elements": []}]}]}]}, {"id": "c142dd0", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "cenik"}, "elements": [{"id": "0c58a1c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-price", "html_tag": "div"}, "elements": [{"id": "9e3a268", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-price-card ww-rv", "html_tag": "div"}, "elements": [{"id": "6e1ebbb", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cena", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "00b8ab1", "elType": "widget", "widgetType": "heading", "settings": {"title": "<small>Tvorba e-shopu</small>na míru", "header_size": "div", "_css_classes": "ww-price-num"}, "elements": []}, {"id": "52fd026", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Konečná cena záleží na rozsahu, funkcích a grafice. Nabídku vám připravíme zdarma a nezávazně.</p>", "_css_classes": "ww-muted"}, "elements": []}, {"id": "e73a9e7", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-row", "html_tag": "div"}, "elements": [{"id": "1d534d1", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci cenovou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}, {"id": "a086c78", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-rv", "html_tag": "div"}, "elements": [{"id": "6ed13e4", "elType": "widget", "widgetType": "heading", "settings": {"title": "Časté otázky – tvorba e-shopu", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "d1c859a", "elType": "widget", "widgetType": "toggle", "settings": {"faq_schema": "yes", "tabs": [{"_id": "9d859f3", "tab_title": "Jak dlouho trvá tvorba e-shopu?", "tab_content": "<p>Menší e-shop bývá hotový za 4–8 týdnů. Záleží hlavně na počtu produktů a napojení.</p>"}, {"_id": "05d15f2", "tab_title": "Pomůžete s importem produktů?", "tab_content": "<p>Ano. Produkty můžeme naimportovat z tabulky nebo z XML feedu dodavatele.</p>"}, {"_id": "c727ce2", "tab_title": "Napojíte e-shop na účetnictví?", "tab_content": "<p>Napojení na běžné fakturační a účetní systémy je možné. Konkrétní řešení probereme v nabídce.</p>"}, {"_id": "78e60b1", "tab_title": "Budu si produkty přidávat sám?", "tab_content": "<p>Ano. Přidávání produktů, úprava cen a vyřizování objednávek zvládnete v administraci.</p>"}, {"_id": "61f4ea3", "tab_title": "Řešíte i obchodní podmínky?", "tab_content": "<p>Pomůžeme s jejich strukturou a umístěním na webu. Právní text doporučujeme nechat zkontrolovat odborníkem.</p>"}], "_css_classes": "ww-faq"}, "elements": []}]}]}]}, {"id": "d4797f1", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "poptavka"}, "elements": [{"id": "b5eb3ab", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "27dbd9b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction