94729", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "fc9a060", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "998ee52", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">E-shop, který prodává, ne jen vystavuje</a><a href=\"#prehled\">Checklist</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "35367c4", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "9783d6c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "b2aa72f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "b816c54", "elType": "widget", "widgetType": "heading", "settings": {"title": "E-shopy", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "5b17ce7", "elType": "widget", "widgetType": "heading", "settings": {"title": "E-shop, který prodává, ne jen vystavuje", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "390e936", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Úspěšný e-shop nestojí na množství funkcí, ale na tom, jak snadno zákazník najde produkt, pochopí jeho výhody a dokončí objednávku. Tvorba e-shopu u nás proto začíná u nákupní cesty zákazníka.</p><p>E-shopy stavíme na WooCommerce (WordPress) nebo PrestaShopu – podle počtu produktů, požadavků na napojení a toho, jak chcete obchod spravovat.</p><p>Tvorba e-shopu na míru zahrnuje i obchodní podmínky, GDPR, napojení plateb a dopravců a základní SEO kategorií a produktů.</p>"}, "elements": []}]}, {"id": "c58eb4a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "011bd85", "elType": "widget", "widgetType": "heading", "settings": {"title": "Součástí e-shopu", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "6bad2c8", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Katalog produktů a kategorií</li><li>Košík a objednávka na pár kliků</li><li>Platební brána a převod</li><li>Napojení na dopravce</li><li>Obchodní podmínky a GDPR</li><li>SEO kategorií a produktů</li><li>Měření prodejů v Analytics</li><li>Zaškolení do administrace</li></ul>"}, "elements": []}, {"id": "5ad77c1", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "467d497", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "d70a3d9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "65589cb", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "76d5fde", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "e370d6c", "elType": "widget", "widgetType": "heading", "settings": {"title": "Checklist", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "e98b367", "elType": "widget", "widgetType": "heading", "settings": {"title": "Tvorba e-shopu: 8 věcí, na kterých záleží", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "baeb59c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Na těchto bodech se rozhoduje, jestli zákazník nakoupí, nebo odejde ke konkurenci.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "4a9c0f7", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-grid4", "html_tag": "div"}, "elements": [{"id": "cf03d5b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "74347ed", "elType": "widget", "widgetType": "heading", "settings": {"title": "01", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "d9c4e68", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jasná navigace", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "ecba98f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Kategorie a filtry, ve kterých se zákazník vyzná bez přemýšlení.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "b2fa8c5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "ba3965f", "elType": "widget", "widgetType": "heading", "settings": {"title": "02", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "d464f6e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Kvalitní produktové stránky", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "f453973", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Fotky, popis, parametry a dostupnost na jednom místě.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "860aa86", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "7b06664", "elType": "widget", "widgetType": "heading", "settings": {"title": "03", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "ff08d64", "elType": "widget", "widgetType": "heading", "settings": {"title": "Důvěra", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "45a29a0", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Kontakty, recenze, obchodní podmínky a jasné informace o vrácení.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "b680f38", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "f1fa1e3", "elType": "widget", "widgetType": "heading", "settings": {"title": "04", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "7a01b60", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jednoduchá objednávka", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "a03cd95", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Co nejméně kroků a polí, nákup i bez registrace.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "abfe791", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "005085c", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "5012a81", "elType": "widget", "widgetType": "heading", "settings": {"title": "Platby a doprava", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "c752f11", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Oblíbené platební metody a výdejní místa.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "5566578", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "2b17c5f", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "12e56dc", "elType": "widget", "widgetType": "heading", "settings": {"title": "Mobil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "a619dd0", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Většina zákazníků nakupuje z telefonu – e-shop musí fungovat na mobilu.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "efb15a7", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "81d38ba", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "95667a0", "elType": "widget", "widgetType": "heading", "settings": {"title": "SEO", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "0c148af", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Unikátní texty kategorií a produktů, které Google dokáže najít.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "7587d3a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "8debd6c", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "a06a684", "elType": "widget", "widgetType": "heading", "settings": {"title": "Měření", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "3191b1f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Víte, odkud zákazníci přicházejí a co nakupují.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "a813111", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "f94dad5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "e99459a", "elType": "widget", "widgetType": "heading", "settings": {"title": "WooCommerce, nebo PrestaShop?", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "60f049e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>WooCommerce je ideální pro menší a střední e-shopy, které chtějí spojit obchod s obsahovým webem a jednoduchou administrací. PrestaShop se hodí pro obchody s větším katalogem a specifickými požadavky.</p><h3>Kolik stojí tvorba e-shopu</h3><p>Cenu ovlivňuje počet produktů, import dat, platby, doprava a napojení na účetnictví nebo sklad. Tvorbu e-shopu naceňujeme individuálně a nabídku připravíme zdarma.</p><h3>Máte už prezentační web?</h3><p>Pokud máte web na WordPressu, můžeme e-shop přidat přímo do něj. Pokud je web zastaralý, zvažte <a href=\"/redesign-webu/\">redesign webu</a> spolu se spuštěním obchodu.</p><h3>Propagace po spuštění</h3><p>E-shop potřebuje návštěvnost. S agenturou Yesmark navážeme PPC kampaněmi, sociálními sítěmi a <a href=\"/seo-optimalizace-webu/\">SEO optimalizací</a>.</p>", "_css_classes": "ww-legaltext"}, "elements": []}]}]}, {"id": "25e0a3c", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "reference"}, "elements": [{"id": "774ba2e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "66ef8d2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "1a52551", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "06faa1d", "elType": "widget", "widgetType": "heading", "settings": {"title": "Reference", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "7cb6dde", "elType": "widget", "widgetType": "heading", "settings": {"title": "Weby, na které jsme hrdí.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "07ccb7a", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Výběr realizací. Celé portfolio webů, e-shopů a kampaní najdete na Yesmark.eu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "a5e37e4", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-refs", "html_tag": "div"}, "elements": [{"id": "ce475f8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "347ff9b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "54cb93f", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 28, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg", "alt": "Reference: web Konradt", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "6fafa0d", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "c42d40a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "d517206", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · CNC obrábění", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "dd25c63", "elType": "widget", "widgetType": "heading", "settings": {"title": "Konradt", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "b116f5b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro společnost KONRADT jsme vytvořili nové webové stránky zaměřené na profesionální prezentaci služeb v oblasti CNC obrábění, montáže a zpracování kovů. Při realizaci jsme kladli důraz na moderní technický vzhled, přehledné představení výrobních možností společnosti a srozumitelnou prezentaci jednotlivých služeb.</p><p>Součástí realizace byla také optimalizace struktury a obsahu webu s ohledem na vyhledávače a lepší dohledatelnost služeb v oblasti CNC frézování, CNC soustružení, montážních prací a dodávek odlitků.</p>"}, "elements": []}, {"id": "61eaf81", "elType": "widget", "widgetType": "button", "settings": {"text": "konradt.cz", "link": {"url": "https://www.konradt.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "8dbac01", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "09659ec", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "591762b", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 29, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-monika-velickova-web.jpg", "alt": "Reference: web Monika Veličková", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "df9b63d", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "e288c7b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "a600278", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Reality Jeseníky", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "3d02504", "elType": "widget", "widgetType": "heading", "settings": {"title": "Monika Veličková", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "6df6924", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro realitní makléřku Moniku Veličkovou jsme vytvořili nové webové stránky zaměřené na prezentaci nemovitostí a realitních služeb v Jeseníkách. Při realizaci jsme kladli důraz na moderní a osobitý design, přehlednou prezentaci nabízených nemovitostí a především na budování osobní značky, která staví na znalosti regionu, individuálním přístupu a zkušenostech s realitami i investicemi.</p>"}, "elements": []}, {"id": "23db47e", "elType": "widget", "widgetType": "button", "settings": {"text": "monikavelickova.cz", "link": {"url": "https://monikavelickova.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "dc0a616", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "13419ec", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "c5c8811", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 27, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-brincil-web.jpg", "alt": "Reference: web Břinčil", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "f3dc538", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "41317c9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "c6bd668", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Technika a služby", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "fd33411", "elType": "widget", "widgetType": "heading", "settings": {"title": "Břinčil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "347fc20", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Při realizaci webu pro firmu Břinčil j