8ad9e", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "79e2142", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "ac6ace5", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">E-shop, který prodává, ne jen vystavuje</a><a href=\"#prehled\">Checklist</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "3dee51d", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "5205fcd", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "08b0d96", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "98cc17e", "elType": "widget", "widgetType": "heading", "settings": {"title": "E-shopy", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "c920e29", "elType": "widget", "widgetType": "heading", "settings": {"title": "E-shop, který prodává, ne jen vystavuje", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "0174b59", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Úspěšný e-shop nestojí na množství funkcí, ale na tom, jak snadno zákazník najde produkt, pochopí jeho výhody a dokončí objednávku. Tvorba e-shopu u nás proto začíná u nákupní cesty zákazníka.</p><p>E-shopy stavíme na WooCommerce (WordPress) nebo PrestaShopu – podle počtu produktů, požadavků na napojení a toho, jak chcete obchod spravovat.</p><p>Tvorba e-shopu na míru zahrnuje i obchodní podmínky, GDPR, napojení plateb a dopravců a základní SEO kategorií a produktů.</p>"}, "elements": []}]}, {"id": "6ed272b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "eb7ee9a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Součástí e-shopu", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "3db723d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Katalog produktů a kategorií</li><li>Košík a objednávka na pár kliků</li><li>Platební brána a převod</li><li>Napojení na dopravce</li><li>Obchodní podmínky a GDPR</li><li>SEO kategorií a produktů</li><li>Měření prodejů v Analytics</li><li>Zaškolení do administrace</li></ul>"}, "elements": []}, {"id": "756ad80", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "dfc67ee", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "59291cc", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "322871b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "4f72f93", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "3e89637", "elType": "widget", "widgetType": "heading", "settings": {"title": "Checklist", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "b2764d2", "elType": "widget", "widgetType": "heading", "settings": {"title": "Tvorba e-shopu: 8 věcí, na kterých záleží", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "7a53764", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Na těchto bodech se rozhoduje, jestli zákazník nakoupí, nebo odejde ke konkurenci.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "8a312cc", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-grid4", "html_tag": "div"}, "elements": [{"id": "ef57d44", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "09ad0a7", "elType": "widget", "widgetType": "heading", "settings": {"title": "01", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "683151e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jasná navigace", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "b15df25", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Kategorie a filtry, ve kterých se zákazník vyzná bez přemýšlení.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "785d974", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "cda1a5a", "elType": "widget", "widgetType": "heading", "settings": {"title": "02", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "3cf0c75", "elType": "widget", "widgetType": "heading", "settings": {"title": "Kvalitní produktové stránky", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "9a1f2bb", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Fotky, popis, parametry a dostupnost na jednom místě.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "d930d26", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "3b4541b", "elType": "widget", "widgetType": "heading", "settings": {"title": "03", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "87d7fde", "elType": "widget", "widgetType": "heading", "settings": {"title": "Důvěra", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "3f4abca", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Kontakty, recenze, obchodní podmínky a jasné informace o vrácení.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "07c8bc6", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "5737937", "elType": "widget", "widgetType": "heading", "settings": {"title": "04", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "3071817", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jednoduchá objednávka", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "6f65798", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Co nejméně kroků a polí, nákup i bez registrace.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "77a3fea", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "26ebd8d", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "ae6d369", "elType": "widget", "widgetType": "heading", "settings": {"title": "Platby a doprava", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "3a92cab", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Oblíbené platební metody a výdejní místa.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "7758d00", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "fb69de7", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "7a6957f", "elType": "widget", "widgetType": "heading", "settings": {"title": "Mobil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "c6b8267", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Většina zákazníků nakupuje z telefonu – e-shop musí fungovat na mobilu.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "2b690e1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "69418ab", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "8ca7234", "elType": "widget", "widgetType": "heading", "settings": {"title": "SEO", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "dfbf5a4", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Unikátní texty kategorií a produktů, které Google dokáže najít.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "95359a8", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "9cf611d", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "5158552", "elType": "widget", "widgetType": "heading", "settings": {"title": "Měření", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "c2d0082", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Víte, odkud zákazníci přicházejí a co nakupují.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "25cdafe", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "9d5299a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "8d8a861", "elType": "widget", "widgetType": "heading", "settings": {"title": "WooCommerce, nebo PrestaShop?", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "5561c1e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>WooCommerce je ideální pro menší a střední e-shopy, které chtějí spojit obchod s obsahovým webem a jednoduchou administrací. PrestaShop se hodí pro obchody s větším katalogem a specifickými požadavky.</p><h3>Kolik stojí tvorba e-shopu</h3><p>Cenu ovlivňuje počet produktů, import dat, platby, doprava a napojení na účetnictví nebo sklad. Tvorbu e-shopu naceňujeme individuálně a nabídku připravíme zdarma.</p><h3>Máte už prezentační web?</h3><p>Pokud máte web na WordPressu, můžeme e-shop přidat přímo do něj. Pokud je web zastaralý, zvažte <a href=\"/redesign-webu/\">redesign webu</a> spolu se spuštěním obchodu.</p><h3>Propagace po spuštění</h3><p>E-shop potřebuje návštěvnost. S agenturou Yesmark navážeme PPC kampaněmi, sociálními sítěmi a <a href=\"/seo-optimalizace-webu/\">SEO optimalizací</a>.</p>", "_css_classes": "ww-legaltext"}, "elements": []}]}]}, {"id": "f0e819b", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "reference"}, "elements": [{"id": "0ce3e08", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "cf5de9c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "5034696", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "369c065", "elType": "widget", "widgetType": "heading", "settings": {"title": "Reference", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "1a0172a", "elType": "widget", "widgetType": "heading", "settings": {"title": "Weby, na které jsme hrdí.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "5f2491c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Výběr realizací. Celé portfolio webů, e-shopů a kampaní najdete na Yesmark.eu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "31a2f40", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-refs", "html_tag": "div"}, "elements": [{"id": "c85507f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "4205e03", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "eb764f3", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 28, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg", "alt": "Reference: web Konradt", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "36951c2", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "3440c74", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "b815b4d", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · CNC obrábění", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "0a42223", "elType": "widget", "widgetType": "heading", "settings": {"title": "Konradt", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "ea7f717", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro společnost KONRADT jsme vytvořili nové webové stránky zaměřené na profesionální prezentaci služeb v oblasti CNC obrábění, montáže a zpracování kovů. Při realizaci jsme kladli důraz na moderní technický vzhled, přehledné představení výrobních možností společnosti a srozumitelnou prezentaci jednotlivých služeb.</p><p>Součástí realizace byla také optimalizace struktury a obsahu webu s ohledem na vyhledávače a lepší dohledatelnost služeb v oblasti CNC frézování, CNC soustružení, montážních prací a dodávek odlitků.</p>"}, "elements": []}, {"id": "c634995", "elType": "widget", "widgetType": "button", "settings": {"text": "konradt.cz", "link": {"url": "https://www.konradt.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "afceb6b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "d9c5943", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "c6dd992", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 29, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-monika-velickova-web.jpg", "alt": "Reference: web Monika Veličková", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "489c4bb", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "77c170f", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "a1e1a59", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Reality Jeseníky", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "a8e86c3", "elType": "widget", "widgetType": "heading", "settings": {"title": "Monika Veličková", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "3745501", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro realitní makléřku Moniku Veličkovou jsme vytvořili nové webové stránky zaměřené na prezentaci nemovitostí a realitních služeb v Jeseníkách. Při realizaci jsme kladli důraz na moderní a osobitý design, přehlednou prezentaci nabízených nemovitostí a především na budování osobní značky, která staví na znalosti regionu, individuálním přístupu a zkušenostech s realitami i investicemi.</p>"}, "elements": []}, {"id": "63a055b", "elType": "widget", "widgetType": "button", "settings": {"text": "monikavelickova.cz", "link": {"url": "https://monikavelickova.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "df69cd3", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "b998407", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "54b7faa", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 27, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-brincil-web.jpg", "alt": "Reference: web Břinčil", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "796f080", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "dacf019", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "897e81d", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Technika a služby", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "ef75d27", "elType": "widget", "widgetType": "heading", "settings": {"title": "Břinčil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "23ebc5a", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Při realizaci webu pro firmu Břinčil j