-row ww-rv", "html_tag": "div"}, "elements": [{"id": "bbaea31", "elType": "widget", "widgetType": "button", "settings": {"text": "Chci nezávaznou nabídku", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}, {"id": "6be72b0", "elType": "widget", "widgetType": "button", "settings": {"text": "Zavolat 731 842 606", "link": {"url": "tel:+420731842606", "is_external": "", "nofollow": ""}, "_css_classes": "ww-btn--ghost ww-btn--plain"}, "elements": []}]}, {"id": "fd14fa7", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><span>✓ Weby od 9 900 Kč</span><span>✓ Nabídka zdarma</span><span>✓ Koncept agentury Yesmark</span></p>", "_css_classes": "ww-trust ww-rv"}, "elements": []}]}, {"id": "92cded2", "elType": "widget", "widgetType": "html", "settings": {"html": "<figure class=\"v-hv\"><img src=\"https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg\" alt=\"Tvorba e-shopu – ukázka webu KONRADT\" decoding=\"async\"><figcaption>Reference · KONRADT</figcaption></figure>", "_css_classes": "ww-rv"}, "elements": []}]}]}, {"id": "2e546ff", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "189fca7", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "6fd4327", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">E-shop, který prodává, ne jen vystavuje</a><a href=\"#prehled\">Checklist</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "438d96d", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "3ae3394", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "e1ca209", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "aab32e5", "elType": "widget", "widgetType": "heading", "settings": {"title": "E-shopy", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "8442e86", "elType": "widget", "widgetType": "heading", "settings": {"title": "E-shop, který prodává, ne jen vystavuje", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "abe6139", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Úspěšný e-shop nestojí na množství funkcí, ale na tom, jak snadno zákazník najde produkt, pochopí jeho výhody a dokončí objednávku. Tvorba e-shopu u nás proto začíná u nákupní cesty zákazníka.</p><p>E-shopy stavíme na WooCommerce (WordPress) nebo PrestaShopu – podle počtu produktů, požadavků na napojení a toho, jak chcete obchod spravovat.</p><p>Tvorba e-shopu na míru zahrnuje i obchodní podmínky, GDPR, napojení plateb a dopravců a základní SEO kategorií a produktů.</p>"}, "elements": []}]}, {"id": "e166a73", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "1461593", "elType": "widget", "widgetType": "heading", "settings": {"title": "Součástí e-shopu", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "7541966", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Katalog produktů a kategorií</li><li>Košík a objednávka na pár kliků</li><li>Platební brána a převod</li><li>Napojení na dopravce</li><li>Obchodní podmínky a GDPR</li><li>SEO kategorií a produktů</li><li>Měření prodejů v Analytics</li><li>Zaškolení do administrace</li></ul>"}, "elements": []}, {"id": "22f687e", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "7bd4917", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "097882d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "8537d84", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "2f02cb4", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "37bfa53", "elType": "widget", "widgetType": "heading", "settings": {"title": "Checklist", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "d99d176", "elType": "widget", "widgetType": "heading", "settings": {"title": "Tvorba e-shopu: 8 věcí, na kterých záleží", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "d8430e9", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Na těchto bodech se rozhoduje, jestli zákazník nakoupí, nebo odejde ke konkurenci.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "aef2ee6", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c