ader_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "dda41cf", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Kontakty, recenze, obchodní podmínky a jasné informace o vrácení.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "eb80856", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "2746826", "elType": "widget", "widgetType": "heading", "settings": {"title": "04", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "0ad0c55", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jednoduchá objednávka", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "41c1935", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Co nejméně kroků a polí, nákup i bez registrace.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "75215b7", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "5a5842d", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "5412393", "elType": "widget", "widgetType": "heading", "settings": {"title": "Platby a doprava", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "05ce7ab", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Oblíbené platební metody a výdejní místa.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "913e9ce", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "f5a7200", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "61cab60", "elType": "widget", "widgetType": "heading", "settings": {"title": "Mobil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "1495bf9", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Většina zákazníků nakupuje z telefonu – e-shop musí fungovat na mobilu.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "d868578", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "573ce67", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "4636096", "elType": "widget", "widgetType": "heading", "settings": {"title": "SEO", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "e26aa31", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Unikátní texty kategorií a produktů, které Google dokáže najít.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "a56e02a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "714b334", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "bf9296f", "elType": "widget", "widgetType": "heading", "settings": {"title": "Měření", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "1ceee3e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Víte, odkud zákazníci přicházejí a co nakupují.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "6e3fb90", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "f905533", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "dd72d6e", "elType": "widget", "widgetType": "heading", "settings": {"title": "WooCommerce, nebo PrestaShop?", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "d4767a7", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>WooCommerce je ideální pro menší a střední e-shopy, které chtějí spojit obchod s obsahovým webem a jednoduchou administrací. PrestaShop se hodí pro obchody s větším katalogem a specifickými požadavky.</p><h3>Kolik stojí tvorba e-shopu</h3><p>Cenu ovlivňuje počet produktů, import dat, platby, doprava a napojení na účetnictví nebo sklad. Tvorbu e-shopu naceňujeme individuálně a nabídku připravíme zdarma.</p><h3>Máte už prezentační web?</h3><p>Pokud máte web na WordPressu, můžeme e-shop přidat přímo do něj. Pokud je web zastaralý, zvažte <a href=\"/redesign-webu/\">redesign webu</a> spolu se spuštěním obchodu.</p><h3>Propagace po spuštění</h3><p>E-shop potřebuje návštěvnost. S agenturou Yesmark navážeme PPC kampaněmi, sociálními sítěmi a <a href=\"/seo-optimalizace-webu/\">SEO optimalizací</a>.</p>", "_css_classes": "ww-legaltext"}, "elements": []}]}]}, {"id": "41f7388", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "reference"}, "elements": [{"id": "088def9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "6b7beee", "elType": "widget", "widgetType": "head