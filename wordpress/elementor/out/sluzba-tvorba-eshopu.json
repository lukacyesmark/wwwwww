894ab", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white ww-tocsec", "html_tag": "section"}, "elements": [{"id": "e49a96e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "3d9413c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p><b>Na této stránce:</b><a href=\"#o-sluzbe\">E-shop, který prodává, ne jen vystavuje</a><a href=\"#prehled\">Checklist</a><a href=\"#detail\">Podrobnosti</a><a href=\"#reference\">Reference</a><a href=\"#cenik\">Cena a FAQ</a><a href=\"#poptavka\">Poptávka</a></p>", "_css_classes": "ww-toc"}, "elements": []}]}]}, {"id": "bb68169", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-white", "html_tag": "section", "_element_id": "o-sluzbe"}, "elements": [{"id": "3ca0eba", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-local", "html_tag": "div"}, "elements": [{"id": "5a81433", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-local-copy ww-rv", "html_tag": "div"}, "elements": [{"id": "9b4c22c", "elType": "widget", "widgetType": "heading", "settings": {"title": "E-shopy", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "e0b8ba8", "elType": "widget", "widgetType": "heading", "settings": {"title": "E-shop, který prodává, ne jen vystavuje", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "9e62267", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Úspěšný e-shop nestojí na množství funkcí, ale na tom, jak snadno zákazník najde produkt, pochopí jeho výhody a dokončí objednávku. Tvorba e-shopu u nás proto začíná u nákupní cesty zákazníka.</p><p>E-shopy stavíme na WooCommerce (WordPress) nebo PrestaShopu – podle počtu produktů, požadavků na napojení a toho, jak chcete obchod spravovat.</p><p>Tvorba e-shopu na míru zahrnuje i obchodní podmínky, GDPR, napojení plateb a dopravců a základní SEO kategorií a produktů.</p>"}, "elements": []}]}, {"id": "43b4d8b", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-citycard ww-rv", "html_tag": "div"}, "elements": [{"id": "e468931", "elType": "widget", "widgetType": "heading", "settings": {"title": "Součástí e-shopu", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "05bf35b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul class=\"ww-checklist\"><li>Katalog produktů a kategorií</li><li>Košík a objednávka na pár kliků</li><li>Platební brána a převod</li><li>Napojení na dopravce</li><li>Obchodní podmínky a GDPR</li><li>SEO kategorií a produktů</li><li>Měření prodejů v Analytics</li><li>Zaškolení do administrace</li></ul>"}, "elements": []}, {"id": "2261076", "elType": "widget", "widgetType": "button", "settings": {"text": "Probrat můj web", "link": {"url": "#poptavka", "is_external": "", "nofollow": ""}}, "elements": []}]}]}]}, {"id": "499eb90", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-dark", "html_tag": "section", "_element_id": "prehled"}, "elements": [{"id": "28ccff1", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "1aaa62a", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "0d54499", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "18c6542", "elType": "widget", "widgetType": "heading", "settings": {"title": "Checklist", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "69b3d11", "elType": "widget", "widgetType": "heading", "settings": {"title": "Tvorba e-shopu: 8 věcí, na kterých záleží", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "c66636f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Na těchto bodech se rozhoduje, jestli zákazník nakoupí, nebo odejde ke konkurenci.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "de93e49", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-grid4", "html_tag": "div"}, "elements": [{"id": "7d395d9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "1c4b194", "elType": "widget", "widgetType": "heading", "settings": {"title": "01", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "3b3e501", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jasná navigace", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "e3886ba", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Kategorie a filtry, ve kterých se zákazník vyzná bez přemýšlení.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "65acd9e", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "d10b5f6", "elType": "widget", "widgetType": "heading", "settings": {"title": "02", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "066630d", "elType": "widget", "widgetType": "heading", "settings": {"title": "Kvalitní produktové stránky", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "8744a4a", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Fotky, popis, parametry a dostupnost na jednom místě.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "86773b9", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "872dc37", "elType": "widget", "widgetType": "heading", "settings": {"title": "03", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "9230ccf", "elType": "widget", "widgetType": "heading", "settings": {"title": "Důvěra", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "1ce6473", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Kontakty, recenze, obchodní podmínky a jasné informace o vrácení.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "28f5b6d", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "3f1b47d", "elType": "widget", "widgetType": "heading", "settings": {"title": "04", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "767f394", "elType": "widget", "widgetType": "heading", "settings": {"title": "Jednoduchá objednávka", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "611c5eb", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Co nejméně kroků a polí, nákup i bez registrace.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "6e8e1fa", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "5157c93", "elType": "widget", "widgetType": "heading", "settings": {"title": "05", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "6f1d855", "elType": "widget", "widgetType": "heading", "settings": {"title": "Platby a doprava", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "11ee85f", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Oblíbené platební metody a výdejní místa.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "8d54143", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "19acecf", "elType": "widget", "widgetType": "heading", "settings": {"title": "06", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "fddd369", "elType": "widget", "widgetType": "heading", "settings": {"title": "Mobil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "ebd0446", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Většina zákazníků nakupuje z telefonu – e-shop musí fungovat na mobilu.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "cbdf6b3", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "afb0fbb", "elType": "widget", "widgetType": "heading", "settings": {"title": "07", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "16f2de6", "elType": "widget", "widgetType": "heading", "settings": {"title": "SEO", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "2ed9e68", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Unikátní texty kategorií a produktů, které Google dokáže najít.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}, {"id": "992f044", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-card ww-mustcard ww-rv", "html_tag": "div"}, "elements": [{"id": "43ab891", "elType": "widget", "widgetType": "heading", "settings": {"title": "08", "header_size": "div", "_css_classes": "ww-num"}, "elements": []}, {"id": "30da9ea", "elType": "widget", "widgetType": "heading", "settings": {"title": "Měření", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "ede5490", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Víte, odkud zákazníci přicházejí a co nakupují.</p>", "_css_classes": "ww-musttext"}, "elements": []}]}]}]}]}, {"id": "acd1660", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "detail"}, "elements": [{"id": "db7ab54", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ww-legal-wrap ww-rv", "html_tag": "div"}, "elements": [{"id": "5aa0d25", "elType": "widget", "widgetType": "heading", "settings": {"title": "WooCommerce, nebo PrestaShop?", "header_size": "h2", "_css_classes": "ww-h2s"}, "elements": []}, {"id": "908e410", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>WooCommerce je ideální pro menší a střední e-shopy, které chtějí spojit obchod s obsahovým webem a jednoduchou administrací. PrestaShop se hodí pro obchody s větším katalogem a specifickými požadavky.</p><h3>Kolik stojí tvorba e-shopu</h3><p>Cenu ovlivňuje počet produktů, import dat, platby, doprava a napojení na účetnictví nebo sklad. Tvorbu e-shopu naceňujeme individuálně a nabídku připravíme zdarma.</p><h3>Máte už prezentační web?</h3><p>Pokud máte web na WordPressu, můžeme e-shop přidat přímo do něj. Pokud je web zastaralý, zvažte <a href=\"/redesign-webu/\">redesign webu</a> spolu se spuštěním obchodu.</p><h3>Propagace po spuštění</h3><p>E-shop potřebuje návštěvnost. S agenturou Yesmark navážeme PPC kampaněmi, sociálními sítěmi a <a href=\"/seo-optimalizace-webu/\">SEO optimalizací</a>.</p>", "_css_classes": "ww-legaltext"}, "elements": []}]}]}, {"id": "c323632", "elType": "container", "isInner": false, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww ww-sec ww-light", "html_tag": "section", "_element_id": "reference"}, "elements": [{"id": "fbfd878", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-wrap ", "html_tag": "div"}, "elements": [{"id": "411c65c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-head ww-rv", "html_tag": "div"}, "elements": [{"id": "190b6c5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ", "html_tag": "div"}, "elements": [{"id": "940de94", "elType": "widget", "widgetType": "heading", "settings": {"title": "Reference", "header_size": "div", "_css_classes": "ww-eyebrow"}, "elements": []}, {"id": "1bdf2d9", "elType": "widget", "widgetType": "heading", "settings": {"title": "Weby, na které jsme hrdí.", "header_size": "h2", "_css_classes": "ww-h2"}, "elements": []}]}, {"id": "52d2ce3", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Výběr realizací. Celé portfolio webů, e-shopů a kampaní najdete na Yesmark.eu.</p>", "_css_classes": "ww-muted ww-lead"}, "elements": []}]}, {"id": "22ae371", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-refs", "html_tag": "div"}, "elements": [{"id": "c236a69", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "013ce5c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "d41fb3d", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 28, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-konradt-web.jpg", "alt": "Reference: web Konradt", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "9bcced8", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "200fba5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "ae8e9df", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · CNC obrábění", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "b1389fd", "elType": "widget", "widgetType": "heading", "settings": {"title": "Konradt", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "bde1a1b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro společnost KONRADT jsme vytvořili nové webové stránky zaměřené na profesionální prezentaci služeb v oblasti CNC obrábění, montáže a zpracování kovů. Při realizaci jsme kladli důraz na moderní technický vzhled, přehledné představení výrobních možností společnosti a srozumitelnou prezentaci jednotlivých služeb.</p><p>Součástí realizace byla také optimalizace struktury a obsahu webu s ohledem na vyhledávače a lepší dohledatelnost služeb v oblasti CNC frézování, CNC soustružení, montážních prací a dodávek odlitků.</p>"}, "elements": []}, {"id": "3b5cf39", "elType": "widget", "widgetType": "button", "settings": {"text": "konradt.cz", "link": {"url": "https://www.konradt.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "8c152a5", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "a5aa43c", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "29ddb68", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 29, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-monika-velickova-web.jpg", "alt": "Reference: web Monika Veličková", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "d55636a", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "ad503a6", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "5be5e5b", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Reality Jeseníky", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "87feeae", "elType": "widget", "widgetType": "heading", "settings": {"title": "Monika Veličková", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "4cf84ba", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Pro realitní makléřku Moniku Veličkovou jsme vytvořili nové webové stránky zaměřené na prezentaci nemovitostí a realitních služeb v Jeseníkách. Při realizaci jsme kladli důraz na moderní a osobitý design, přehlednou prezentaci nabízených nemovitostí a především na budování osobní značky, která staví na znalosti regionu, individuálním přístupu a zkušenostech s realitami i investicemi.</p>"}, "elements": []}, {"id": "a60b5d0", "elType": "widget", "widgetType": "button", "settings": {"text": "monikavelickova.cz", "link": {"url": "https://monikavelickova.cz/", "is_external": "on", "nofollow": ""}, "_css_classes": "ww-btn--plain ww-btn--ext"}, "elements": []}]}]}, {"id": "a384850", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref ww-rv", "html_tag": "div"}, "elements": [{"id": "514a5f2", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-top", "html_tag": "div"}, "elements": [{"id": "4623849", "elType": "widget", "widgetType": "image", "settings": {"image": {"id": 27, "url": "https://wwwwww.cz/wp-content/uploads/2026/10/reference-brincil-web.jpg", "alt": "Reference: web Břinčil", "source": "library"}, "image_size": "large", "_css_classes": "ww-ref-shot"}, "elements": []}, {"id": "4d3d61f", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"ww-ref-hint\">Projeďte web ↓</span>", "_css_classes": "ww-ref-hintw"}, "elements": []}]}, {"id": "cb107c6", "elType": "container", "isInner": true, "settings": {"content_width": "full", "flex_direction": "column", "css_classes": "ww-c ww-ref-body", "html_tag": "div"}, "elements": [{"id": "5775fc7", "elType": "widget", "widgetType": "heading", "settings": {"title": "Web · Technika a služby", "header_size": "div", "_css_classes": "ww-ref-tag"}, "elements": []}, {"id": "5efce9f", "elType": "widget", "widgetType": "heading", "settings": {"title": "Břinčil", "header_size": "h3", "_css_classes": "ww-h3"}, "elements": []}, {"id": "17249e1", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Při realizaci webu pro firmu Břinčil j